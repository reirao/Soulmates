<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<DefaultItemExcludes>$(DefaultItemExcludes);SoulmatesRegressionProbe\**</DefaultItemExcludes>
    <TML_PATH Condition="'$(TML_PATH)' == ''">C:\Program Files (x86)\Steam\steamapps\common\tModLoader</TML_PATH>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Hjson" HintPath="$(TML_PATH)\Libraries\hjson\3.0.0\lib\netstandard1.3\Hjson.dll" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="FNA" HintPath="$(TML_PATH)\Libraries\FNA\1.0.0\FNA.dll" />
    <Compile Include="..\Common\SoulmatesTextLayout.cs" Link="SoulmatesTextLayout.cs" />
    <Compile Include="..\Common\UI\SoulmatesUISpace.cs" Link="SoulmatesUISpace.cs" />
  </ItemGroup>
</Project>
