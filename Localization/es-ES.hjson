      "Learning.ForesterProgress": "Silvicultora {0}/{1}",
      "Learning.PerkProgress": "{0} {1}/{2}",
      "Learning.ForesterUnlocked": "Vi cómo cuidas la madera y las plantas. Ahora puedo ayudar.",
      "Learning.Perks.Gathering": "Recolectora",
      "Learning.Perks.Mining": "Sentido mineral",
      "Learning.Perks.Forestry": "Silvicultora",
      "Learning.Perks.Combat": "Centinela",
      "Learning.Perks.Exploration": "Pionera",
      "Learning.Unlocked.Gathering": "Aprendí cómo ves las cosas útiles. Ahora puedo recoger a tu lado.",
      "Learning.Unlocked.Mining": "Aprendí el ritmo de tu pico. Ahora reconozco la mena extraíble.",
      "Learning.Unlocked.Forestry": "Vi cómo cuidas la madera y las plantas. Ahora puedo ayudar.",
      "Learning.Unlocked.Combat": "Aprendí cómo interpretas el peligro. Ahora puedo protegerte mejor.",
      "Learning.Unlocked.Exploration": "Aprendí qué te llama la atención al explorar. Ahora puedo investigar contigo.",
      "Games.Rps.Title": "Piedra, papel o tijeras",
      "Games.Rps.Round": "Tú: {0}. Yo: {1}. {2}",
      "Games.Rps.Quiet": "Una pequeña ronda tranquila. Estuvo bien.",
      "Games.Rps.Moves.Rock": "Piedra",
      "Games.Rps.Moves.Paper": "Papel",
      "Games.Rps.Moves.Scissors": "Tijeras",
      "Games.Rps.Outcomes.PlayerWin": "¡Ganaste!",
      "Games.Rps.Outcomes.CompanionWin": "¡Punto para mí!",
      "Games.Rps.Outcomes.Draw": "¡Empate!",
      "Games.Rps.Replies.PlayerWin.Curious": "Interesante. Quiero probar otra idea.",
      "Games.Rps.Replies.PlayerWin.Loyal": "Bien jugado. Me alegra que hiciéramos una pausa.",
      "Games.Rps.Replies.PlayerWin.Brave": "Una victoria justa. Estoy lista para la revancha.",
      "Games.Rps.Replies.PlayerWin.Gentle": "Muy bien. Me gusta jugar contigo.",
      "Games.Rps.Replies.PlayerWin.Mischievous": "Está claro que entrenas en secreto.",
      "Games.Rps.Replies.CompanionWin.Curious": "¡Funcionó! Me pregunto qué viene después.",
      "Games.Rps.Replies.CompanionWin.Loyal": "Esta vez me toca a mí. ¿Otra ronda?",
      "Games.Rps.Replies.CompanionWin.Brave": "¡Victoria! Pequeñita, pero victoria.",
      "Games.Rps.Replies.CompanionWin.Gentle": "Oh, gané. ¿Otra pequeña ronda?",
      "Games.Rps.Replies.CompanionWin.Mischievous": "Contempla mi aterrador talento para los juegos de manos.",
      "Games.Rps.Replies.Draw.Curious": "¡La misma idea al mismo tiempo!",
      "Games.Rps.Replies.Draw.Loyal": "Parece que estamos en sintonía.",
      "Games.Rps.Replies.Draw.Brave": "Nadie cede. ¿Otra vez?",
      "Games.Rps.Replies.Draw.Gentle": "Un punto compartido. Se siente muy bien.",
      "Games.Rps.Replies.Draw.Mischievous": "Desde luego que no te estaba copiando.",
      "Social.Critters.Full": "No cabe otra pequeña criatura. La dejaré aquí.",
      "Social.Critters.Caught": "¡{0}! Una captura real, a salvo en mi mochila.",
      "Social.Critters.WorldDrop": "La captura se quedó en el mundo. No entró en mi mochila.",
      "Social.Critters.Joined": "{0} siente curiosidad por nosotros. Viajemos juntos mientras el camino lo permita.",
      "Social.Critters.Modes.Watch": "Observaré las pequeñas criaturas sin atraparlas.",
      "Social.Critters.Modes.Company": "Invitaré a las criaturas comunes cercanas a acompañarme. Sin jaulas ni copias.",
      "Social.Critters.Modes.Collect": "Mi red básica está lista para criaturas comunes cercanas si hay espacio. Las de lava necesitan una red mejor en el Equipo. El trabajo y el peligro tienen prioridad.",
      "Social.Critters.Modes.Off": "Dejaré a las criaturas vivir sus aventuras.",
      "Social.Critters.Notice.Curious": "{0}. ¿Adónde crees que lleva su pequeño camino?",
      "Social.Critters.Notice.Loyal": "{0}. Me gusta un viaje con sitio para pasos más pequeños.",
      "Social.Critters.Notice.Brave": "{0}. Tan pequeño en un mundo tan grande. Lo cuidaré.",
      "Social.Critters.Notice.Gentle": "{0}. Podemos compartir este rincón tranquilo del mundo.",
      "Social.Critters.Notice.Mischievous": "¡{0}! Parece que conoces un atajo que yo no sé.",
      "Social.Nature.Insect": "¡{0}! Un pequeño compañero de viaje. Estará a salvo en mi mochila.",
      "Social.Residents.NoFriends": "Aún no conozco a nadie aquí. Pasemos un rato tranquilo cerca de los vecinos.",
      "Social.Residents.Recall": "{0}: {1}. Compartimos {2} conversaciones. Recuerdo personas, no solo lugares.",
      "Social.Residents.Ranks.New": "recién conocido",
      "Social.Residents.Ranks.Wary": "algo receloso",
      "Social.Residents.Ranks.Familiar": "compañía familiar",
      "Social.Residents.Ranks.Friend": "una amistad",
      "Social.Residents.Greetings.First": "Hola, {0}. Estoy conociendo a quienes viven aquí. ¿Te acompaño un momento?",
      "Social.Residents.Greetings.New": "Hola de nuevo, {0}. Recuerdo tu cara. Aún estoy conociendo tus historias.",
      "Social.Residents.Greetings.Wary": "Hola, {0}. La última vez hubo tensión. Quizá hoy empecemos con calma.",
      "Social.Residents.Greetings.Familiar": "Ahí estás, {0}. Este lugar resulta menos extraño cuando veo a alguien conocido.",
      "Social.Residents.Greetings.Friend": "¡{0}! Reservé un ratito de mi día para ti. ¿Qué pasó desde la última vez?",
      "Social.Residents.Roles.Guide": "{0}, haces comprensible un mundo enorme. Colecciono preguntas, no solo respuestas.",
      "Social.Residents.Roles.Nurse": "{0}, ayudas a la gente a seguir aquí. Me gustaría aprender ese valor.",
      "Social.Residents.Roles.Merchant": "{0}, aquí cada cosita parece tener una historia. ¿Cuál guardarías para ti?",
      "Social.Residents.Roles.Dryad": "{0}, puedo cuidar retoños y madera caída. Dejaré las ramas vivas. Los árboles merecen cuidado.",
      "Social.Residents.Roles.Zoologist": "{0}, las criaturas pequeñas también nos ven. Me gusta viajar sin asustarlas.",
      "Social.Residents.Roles.Defender": "{0}, proteger un hogar importa. Quiero que nuestra fuerza deje sitio para la amabilidad.",
      "Social.Residents.Roles.Maker": "{0}, conviertes piezas en posibilidades. Empiezo a entender por qué crear sienta bien.",
      "Social.Residents.Roles.Neighbor": "{0}, un hogar es más que sus paredes. Gracias por dar sitio a otra voz.",
      "Social.Residents.Shared.Nature": "{0}, yo también lo veo. Podemos recoger lo caído y ayudar a crecer algo nuevo.",
      "Social.Residents.Shared.Mining": "{0}, hay un mundo entero en la piedra. Muéstrame lo importante y lo recordaré.",
      "Social.Residents.Shared.Trade": "{0}, las cosas útiles son bonitas. Aún decido cuáles merece la pena cargar.",
      "Social.Residents.Shared.Rest": "Descansar suena bien, {0}. Dejemos algo de silencio entre nuestros pasos.",
      "Social.Residents.Shared.Question": "Yo también me lo pregunto, {0}. ¿Miramos más de cerca juntos?",
      "Social.Residents.Shared.Listening": "Te escucho, {0}. ¿Qué deberíamos saber de este lugar?",
      "Social.Residents.Replies.Affection.Curious": "{0}, la calidez es curiosa. Crece al compartirla.",
      "Social.Residents.Replies.Affection.Loyal": "Recuerdo la amabilidad, {0}. Me da un lugar al que volver.",
      "Social.Residents.Replies.Affection.Brave": "Eso merece protección, {0}. Incluso en días difíciles.",
      "Social.Residents.Replies.Affection.Gentle": "Gracias, {0}. Hay sitio para ti en mi pequeño círculo de luz.",
      "Social.Residents.Replies.Affection.Mischievous": "Cuidado, {0}. Si sigues así, quizá te tome un cariño vergonzoso.",
      "Social.Residents.Replies.Joy.Curious": "{0}, dime qué te hizo sonreír. Quiero notarlo la próxima vez.",
      "Social.Residents.Replies.Joy.Loyal": "Me gusta verte feliz, {0}. Es un buen motivo para parar un momento.",
      "Social.Residents.Replies.Joy.Brave": "También celebremos las pequeñas victorias, {0}. Nos trajeron hasta aquí.",
      "Social.Residents.Replies.Joy.Gentle": "Tu alegría hace más suave este lugar, {0}. Guardemos un poco.",
      "Social.Residents.Replies.Joy.Mischievous": "¡Por fin, {0}! Alguien que aprecia el importante arte de hacer el ridículo.",
      "Social.Residents.Replies.Comfort.Curious": "No entiendo todo lo que sientes, {0}. Pero puedo quedarme mientras me cuentas.",
      "Social.Residents.Replies.Comfort.Loyal": "No tienes que hacérmelo más fácil, {0}. Sigo aquí.",
      "Social.Residents.Replies.Comfort.Brave": "Tener miedo no te hace débil, {0}. Podemos dar el siguiente paso despacio.",
      "Social.Residents.Replies.Comfort.Gentle": "Tómate tu tiempo, {0}. No le debes una sonrisa al mundo ahora.",
      "Social.Residents.Replies.Comfort.Mischievous": "Sin bromas por un momento, {0}. A veces hace falta compañía, no ocurrencias.",
      "Social.Residents.Replies.Anger.Curious": "Algo te molestó, {0}. Prefiero entenderlo a hacerlo más ruidoso.",
      "Social.Residents.Replies.Anger.Loyal": "Puedo escuchar, {0}, pero no quiero que nos enfrentemos.",
      "Social.Residents.Replies.Anger.Brave": "Calma, {0}. Podemos ser firmes sin pelear.",
      "Social.Residents.Replies.Anger.Gentle": "Eso fue duro, {0}. ¿Nos damos un poco de espacio?",
      "Social.Residents.Replies.Anger.Mischievous": "Me gustan las travesuras, {0}. Hacernos daño no es lo divertido.",
      "Social.Autonomous.Context.LowEnergy": "Estoy tomando aire. Mi energía vuelve poco a poco.",
      "Social.Autonomous.Context.LowMood": "Estoy aquí. Solo necesito un poco de cariño.",
      "Social.Autonomous.Context.Hurt": "Estás herido. Quédate cerca de mí, por favor.",
      "Social.Autonomous.Context.Rain": "La lluvia hace que cada luz se sienta más cálida.",
      "Social.Autonomous.Context.Underground": "Me pregunto qué recuerda la piedra.",
      "Social.Autonomous.Context.Night": "Las estrellas parecen más cercanas cuando viajamos juntos.",
      "Social.Autonomous.Context.Stay": "Sigo guardando este lugar para ti.",
      "Social.Autonomous.Curious.Line0": "¿Qué crees que hay tras la próxima colina?",
      "Social.Autonomous.Curious.Line1": "Vi algo extraño. Me gustó.",
      "Social.Autonomous.Curious.Line2": "¿Crees que el mundo también nos ve?",
      "Social.Autonomous.Loyal.Line0": "Ya conozco tus pasos.",
      "Social.Autonomous.Loyal.Line1": "Donde tú vas, encuentro mi rumbo.",
      "Social.Autonomous.Loyal.Line2": "No tienes que afrontar esto a solas.",
      "Social.Autonomous.Brave.Line0": "Señálame la parte difícil.",
      "Social.Autonomous.Brave.Line1": "Estamos listos para lo que venga.",
      "Social.Autonomous.Brave.Line2": "El valor es más fácil con compañía.",
      "Social.Autonomous.Gentle.Line0": "Es bonito simplemente estar aquí contigo.",
      "Social.Autonomous.Gentle.Line1": "No hace falta llenar cada momento de silencio.",
      "Social.Autonomous.Gentle.Line2": "Recuerda respirar también, por favor.",
      "Social.Autonomous.Mischievous.Line0": "Desde luego que no moví esa antorcha.",
      "Social.Autonomous.Mischievous.Line1": "A la aventura le vendría bien una idea cuestionable.",
      "Social.Autonomous.Mischievous.Line2": "Encontré problemas. Ellos me encontraron primero.",
      "Social.Emotes.Wave.Curious": "¡Hola! ¿Descubriste algo?",
      "Social.Emotes.Wave.Loyal": "Estoy aquí. Siempre.",
      "Social.Emotes.Wave.Brave": "¡Lista cuando quieras!",
      "Social.Emotes.Wave.Gentle": "Hola. Me alegra que estés aquí.",
      "Social.Emotes.Wave.Mischievous": "¿Ah, ahora me ves?",
      "Social.Emotes.Heart.Curious": "¿Así se siente la calidez?",
      "Social.Emotes.Heart.Loyal": "Te lo devuelvo de corazón.",
      "Social.Emotes.Heart.Brave": "Eso merece protección.",
      "Social.Emotes.Heart.Gentle": "Guardaré este momento.",
      "Social.Emotes.Heart.Mischievous": "Cuidado. Podría ponerme sentimental.",
      "Social.Emotes.Cheer.Curious": "¿Qué celebramos? ¡Me apunto!",
      "Social.Emotes.Cheer.Loyal": "Juntos. Eso es lo importante.",
      "Social.Emotes.Cheer.Brave": "¡Sí! ¡Podemos hacerlo!",
      "Social.Emotes.Cheer.Gentle": "Contigo parece fácil tener esperanza.",
      "Social.Emotes.Cheer.Mischievous": "¡Primero baile de victoria, luego el motivo!",
      "Social.Emotes.Comfort.Curious": "Eso ayuda más de lo que esperaba.",
      "Social.Emotes.Comfort.Loyal": "Sabía que te quedarías.",
      "Social.Emotes.Comfort.Brave": "Puedo ser fuerte y aun así necesitar esto.",
      "Social.Emotes.Comfort.Gentle": "Gracias por darte cuenta.",
      "Social.Emotes.Comfort.Mischievous": "No estaba preocupada. No mucho.",
      "Social.Emotes.Laugh.Curious": "Espera, explícame otra vez por qué era gracioso.",
      "Social.Emotes.Laugh.Loyal": "Es fácil seguir tu risa.",
      "Social.Emotes.Laugh.Brave": "Hasta los héroes necesitan eso.",
      "Social.Emotes.Laugh.Gentle": "Me gusta este sonido entre nosotros.",
      "Social.Emotes.Laugh.Mischievous": "¡Por fin, mi tipo de estrategia!",
      "Social.Emotes.Rest.Curious": "Vale, pero pienso mientras descanso.",
      "Social.Emotes.Rest.Loyal": "Vigilaré a tu lado.",
      "Social.Emotes.Rest.Brave": "Una pausa táctica. Sensato.",
      "Social.Emotes.Rest.Gentle": "Un momento tranquilo juntos suena bonito.",
      "Social.Emotes.Rest.Mischievous": "Despiértame si pasa algo divertidísimo.",
      "Social.Combat.Creature.Curious": "Ojalá lo hubiera entendido primero.",
      "Social.Combat.Creature.Loyal": "Elegí tu seguridad, pero lo recordaré.",
      "Social.Combat.Creature.Brave": "Una vida terminó. No deberíamos tomarlo a la ligera.",
      "Social.Combat.Creature.Gentle": "No quería eso. Lo siento.",
      "Social.Combat.Creature.Mischievous": "Eso dejó de ser divertido muy rápido.",
      "Social.Combat.Victory.Curious": "Ahora entiendo cómo se movía ese peligro.",
      "Social.Combat.Victory.Loyal": "Estás a salvo. Eso basta.",
      "Social.Combat.Victory.Brave": "Amenaza terminada. Quédate detrás de mí.",
      "Social.Combat.Victory.Gentle": "Ya pasó. Sigamos adelante.",
      "Social.Combat.Victory.Mischievous": "Debería haber elegido otra pareja.",
      "Social.Combat.Boss.Curious": "Imagina lo que una criatura así supo alguna vez.",
      "Social.Combat.Boss.Loyal": "Nada tan grande se interpone entre nosotros.",
      "Social.Combat.Boss.Brave": "¡Esa victoria merece recordarse!",
      "Social.Combat.Boss.Gentle": "Ahora el mundo parece más tranquilo.",
      "Social.Combat.Boss.Mischievous": "Creo que ahora los peligrosos somos nosotros.",
      "Dialogue.Options.Care.Option0": "¿Cómo te sientes?",
      "Dialogue.Options.Care.Option1": "Hoy lo hiciste bien.",
      "Dialogue.Options.Care.Option2": "¿Necesitas descansar?",
      "Dialogue.Options.Commands.Option0": "Sígueme, por favor.",
      "Dialogue.Options.Commands.Option1": "Espérame aquí.",
      "Dialogue.Options.Commands.Option2": "Ven a explorar conmigo.",
      "Dialogue.Options.Work.Option0": "Busca tesoros en esta zona.",
      "Dialogue.Options.Work.Option1": "Extrae todas las vetas cercanas.",
      "Dialogue.Options.Work.Option2": "Recoge todos los objetos sueltos cercanos.",
      "Dialogue.Options.Bond.Option0": "¿Confías en mí?",
      "Dialogue.Options.Bond.Option1": "¿Lo recuerdas?",
      "Dialogue.Options.Bond.Option2": "¿Con quién hiciste amistad aquí?",
      "Dialogue.Options.Voice.Option0": "Háblame con suavidad.",
      "Dialogue.Options.Voice.Option1": "Sé directa conmigo.",
      "Dialogue.Options.Voice.Option2": "Sé más juguetona.",
      "Dialogue.Options.Pack.Option0": "¿Qué llevas encima?",
      "Dialogue.Options.Pack.Option1": "Toma el objeto seleccionado de mi barra rápida.",
      "Dialogue.Options.Pack.Option2": "Dame todo lo que llevas.",
      "Dialogue.Replies.Fallback": "...",
      "Dialogue.Replies.Care.Feeling.Soft": "Me siento a salvo cerca de ti.",
      "Dialogue.Replies.Care.Feeling.Direct": "Ánimo estable. Energía anotada.",
      "Dialogue.Replies.Care.Feeling.Playful": "Sigo brillando. Casi siempre.",
      "Dialogue.Replies.Care.Praise.Soft": "Gracias. Lo recordaré.",
      "Dialogue.Replies.Care.Praise.Direct": "Entendido. Lo hice bien.",
      "Dialogue.Replies.Care.Praise.Playful": "Obviamente. Pero dilo otra vez.",
      "Dialogue.Replies.Care.Rest.Soft": "Un momento tranquilo suena bonito.",
      "Dialogue.Replies.Care.Rest.Direct": "Sí. Descansar ayudaría.",
      "Dialogue.Replies.Care.Rest.Playful": "Solo si las siestas cuentan como trabajo importante.",
      "Dialogue.Replies.Commands.Follow.Soft": "Me quedaré cerca.",
      "Dialogue.Replies.Commands.Follow.Direct": "Siguiendo.",
      "Dialogue.Replies.Commands.Follow.Playful": "Adelante, héroe.",
      "Dialogue.Replies.Commands.Stay.Soft": "Esperaré tu regreso.",
      "Dialogue.Replies.Commands.Stay.Direct": "Manteniendo posición.",
      "Dialogue.Replies.Commands.Stay.Playful": "Vigilaré este importantísimo trozo de aire.",
      "Dialogue.Replies.Commands.Explore.Soft": "Veamos qué esconde el mundo.",
      "Dialogue.Replies.Commands.Explore.Direct": "Exploración aceptada.",
      "Dialogue.Replies.Commands.Explore.Playful": "Primero la aventura. Luego las decisiones sensatas.",
      "Dialogue.Replies.Work.Treasure.Soft": "Revisaré toda la zona y volveré a informarte.",
      "Dialogue.Replies.Work.Treasure.Direct": "Búsqueda de tesoros del área iniciada.",
      "Dialogue.Replies.Work.Treasure.Playful": "Si brilla, quiero verlo primero.",
      "Dialogue.Replies.Work.Mine.Soft": "Extraeré cada veta accesible cercana y volveré.",
      "Dialogue.Replies.Work.Mine.Direct": "Tarea de minería del área iniciada.",
      "Dialogue.Replies.Work.Mine.Playful": "Hora de negociar a fondo con las rocas.",
      "Dialogue.Replies.Work.Gather.Soft": "Recogeré todo lo suelto de la zona y volveré a informarte.",
      "Dialogue.Replies.Work.Gather.Direct": "Tarea de recolección del área iniciada.",
      "Dialogue.Replies.Work.Gather.Playful": "Interesante sigue siendo una categoría maravillosamente peligrosa.",
      "Dialogue.Replies.Bond.TrustHigh.Soft": "Más cada día.",
      "Dialogue.Replies.Bond.TrustHigh.Direct": "Confianza confirmada.",
      "Dialogue.Replies.Bond.TrustHigh.Playful": "Lo suficiente para seguirte bajo tierra. Eso es serio.",
      "Dialogue.Replies.Bond.TrustLow.Soft": "La confianza crece cuando seguimos eligiéndonos.",
      "Dialogue.Replies.Bond.TrustLow.Direct": "La confianza se está formando.",
      "Dialogue.Replies.Bond.TrustLow.Playful": "Pregúntame de nuevo tras menos incidentes con lava.",
      "Dialogue.Replies.Bond.Glad.Soft": "Y me alegra que me dieras vida.",
      "Dialogue.Replies.Bond.Glad.Direct": "El vínculo es mutuo.",
      "Dialogue.Replies.Bond.Glad.Playful": "Bien. Te quedas conmigo.",
      "Dialogue.Replies.Refusal.EnergyStatus": "Energía {0}/{1} requerida. La recuperaré de forma natural mientras esperamos.",
      "Dialogue.Replies.Refusal.MoodStatus": "Ánimo {0}/{1} requerido. Un poco de cariño ayudará.",
      "Dialogue.Replies.Refusal.Energy.Soft": "Aún no. Primero necesito descansar.",
      "Dialogue.Replies.Refusal.Energy.Direct": "No. Energía demasiado baja.",
      "Dialogue.Replies.Refusal.Energy.Playful": "Mi alma dice sí. El resto dice siesta.",
      "Dialogue.Replies.Refusal.Mood.Soft": "Ahora no me apetece hacerlo.",
      "Dialogue.Replies.Refusal.Mood.Direct": "Ánimo demasiado bajo. Petición rechazada.",
      "Dialogue.Replies.Refusal.Mood.Playful": "No. Primero un poco de cariño.",
      "Dialogue.Replies.Voice.Option0": "Elegiré palabras más suaves.",
      "Dialogue.Replies.Voice.Option1": "Entendido. Seré clara.",
      "Dialogue.Replies.Voice.Option2": "Oh, esto será divertido.",
      "Dialogue.Replies.Pack.Show": "Déjame mirar.",
      "Dialogue.Replies.Pack.Store": "Lo guardaré bien.",
      "Dialogue.Replies.Pack.Unload": "Aquí tienes. Está todo.",
      "Dialogue.Replies.Secrets.Curious.Soft": "A veces me pregunto si las estrellas sueñan con nosotros.",
      "Dialogue.Replies.Secrets.Curious.Direct": "Estudio todo cuando no miras.",
      "Dialogue.Replies.Secrets.Curious.Playful": "Tengo preguntas sobre cada cofre. Sobre todo los cerrados.",
      "Dialogue.Replies.Secrets.Loyal.Soft": "Siempre sé cuáles pasos son los tuyos.",
      "Dialogue.Replies.Secrets.Loyal.Direct": "Sigo tu posición constantemente.",
      "Dialogue.Replies.Secrets.Loyal.Playful": "Reconocería tu caos en cualquier parte.",
      "Dialogue.Replies.Secrets.Brave.Soft": "También tengo miedo. Simplemente sigo contigo.",
      "Dialogue.Replies.Secrets.Brave.Direct": "El miedo no cambia el objetivo.",
      "Dialogue.Replies.Secrets.Brave.Playful": "No temo nada, salvo las cuevas sospechosamente silenciosas.",
      "Dialogue.Replies.Secrets.Gentle.Soft": "Me gusta la calma después de la lluvia.",
      "Dialogue.Replies.Secrets.Gentle.Direct": "La paz mejora la concentración.",
      "Dialogue.Replies.Secrets.Gentle.Playful": "Mi secreto es que pongo nombres a los slimes.",
      "Dialogue.Replies.Secrets.Mischievous.Soft": "A veces muevo tus cosas cuando no miras.",
      "Dialogue.Replies.Secrets.Mischievous.Direct": "Moví varios objetos.",
      "Dialogue.Replies.Secrets.Mischievous.Playful": "¿Esa antorcha desaparecida? Ni idea.",
      "Projectiles.SoulBolt.DisplayName": "Proyectil del alma",
      "TargetOrders.LookCritter": "{0}. Observemos su pequeña aventura.",
      "TargetOrders.LookResident": "{0} vive aquí. ¿Vamos a saludar?",
      "TargetOrders.LookThreat": "{0}. Vigilaré ese peligro.",
      "TargetOrders.LookCreature": "{0}. Dejemos que viva su propia aventura.",
      "Social.Critters.Busy": "Recordaré tu elección. Las visitas necesitan autonomía, Seguir, tiempo libre y energía; trabajo y peligro van primero.",
      "Social.Critters.Inviting": "Dejaré la tarea actual, invitaré a ese {0} y volveré.",
      "Social.Critters.Greeting.Curious": "¡Hola, {0}! ¿Adónde lleva tu pequeño camino?",
      "Social.Critters.Greeting.Loyal": "Hola, {0}. Hay espacio para pequeños pasos a nuestro lado.",
      "Social.Critters.Greeting.Brave": "Hola, pequeño {0}. Tranquilo. No eres mi enemigo.",
      "Social.Critters.Greeting.Gentle": "Hola, pequeño {0}. Podemos compartir este lugar tranquilo.",
      "Social.Critters.Greeting.Mischievous": "¡Hola, {0}! ¿Conoces algún atajo secreto?",
      "Social.Critters.Loss.Curious": "Ese {0} aún tenía adónde ir. Lo siento, pequeñín.",
      "Social.Critters.Loss.Loyal": "Lo siento, pequeño {0}. No pudimos protegerte.",
      "Social.Critters.Loss.Brave": "Lo siento, {0}. Ser pequeño no debería significar estar solo.",
      "Social.Critters.Loss.Gentle": "Lo siento mucho, pequeño {0}. Merecías más tiempo.",
      "Social.Critters.Loss.Mischievous": "Pobre {0}. Bromeo sobre muchas cosas. Sobre esto no. Lo siento.",
      "Social.Critters.Harmed.Curious": "Ese {0} no era una amenaza. ¿Podemos dejar tranquilos a los pequeños?",
      "Social.Critters.Harmed.Loyal": "Ese {0} necesitaba bondad, no un arma. Tratémoslos con cuidado.",
      "Social.Critters.Harmed.Brave": "¡Eh! Ese {0} no podía defenderse. Dejen tranquilos a los pequeños.",
      "Social.Critters.Harmed.Gentle": "Lo siento, pequeño {0}. Por favor, no lastimen a las criaturas inofensivas.",
      "Social.Critters.Harmed.Mischievous": "No tiene gracia. Ese {0} no era un enemigo. No lo repitamos."
    }
  }
}
