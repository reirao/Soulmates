      "Social.Combat.Boss.Mischievous": "Acho que agora os perigosos somos nós.",
      "Dialogue.Options.Care.Option0": "Como você se sente?",
      "Dialogue.Options.Care.Option1": "Você foi bem hoje.",
      "Dialogue.Options.Care.Option2": "Precisa descansar?",
      "Dialogue.Options.Commands.Option0": "Siga-me, por favor.",
