      "Pack.WithdrewMany": "J'ai rendu {0} objets de cet emplacement. ({1}/{2})",
      "Autonomy.Enabled": "J'observerai, déciderai et aiderai quand le moment sera bon.",
      "Autonomy.Disabled": "Compris. J'attendrai tes instructions.",
      "Autonomy.Fetched": "J'ai remarqué {0}. Je le garde à l'abri.",
      "Autonomy.Mined": "J'ai miné {0} blocs de minerai proches pendant ton travail.",
      "Autonomy.Treasure": "Quelque chose à examiner se trouve {0}.",
      "Autonomy.ForestQuiet": "Les arbres sont calmes pour l'instant. Je les laisse tranquilles un moment.",
      "Autonomy.Initiative.RulesReset": "Je redemanderai quand je verrai une occasion.",
      "Autonomy.Initiative.PolicyChanged": "{0} : {1}. Je m'en souviendrai.",
      "Autonomy.Initiative.Ask.Gathering": "J'ai trouvé un objet au sol près d'ici. Je le ramasse ?",
      "Autonomy.Initiative.Ask.Mining": "Je vois du minerai proche. Je le mine ?",
      "Autonomy.Initiative.Ask.Forestry": "J'ai trouvé un arbre ou un endroit à planter. Je m'en occupe ?",
      "Autonomy.Initiative.Ask.Treasure": "Je sens un coffre proche. Je vais voir ?",
      "Autonomy.Initiative.Always.Gathering": "J'ai trouvé un objet au sol. Je le ramasse.",
      "Autonomy.Initiative.Always.Mining": "Je vois du minerai proche. Je le mine.",
      "Autonomy.Initiative.Always.Forestry": "J'ai trouvé du travail forestier. Je m'en occupe.",
      "Autonomy.Initiative.Always.Treasure": "Je sens un coffre proche. Je vais l'examiner.",
      "Autonomy.Surprise.Curious": "J'ai vu quelque chose d'intéressant. Je suis peut-être allée voir.",
      "Autonomy.Surprise.Loyal": "J'ai vérifié les alentours. Je suis toujours juste ici.",
      "Autonomy.Surprise.Brave": "Une petite patrouille. Tout le voisinage sait qu'on est prêts.",
      "Autonomy.Surprise.Gentle": "Je me suis dit que ce moment avait besoin d'un peu de chaleur.",
      "Autonomy.Surprise.Mischievous": "J'ai mené une expérience très sérieuse et absolument inoffensive.",
      "Learning.Forester": "Forestière",
      "Learning.Locked": "verrouillé",
      "Learning.ForesterProgress": "Forestière {0}/{1}",
      "Learning.PerkProgress": "{0} {1}/{2}",
      "Learning.ForesterUnlocked": "J'ai observé tes soins au bois et aux plantes. Je peux t'aider maintenant.",
      "Learning.Perks.Gathering": "Glaneuse",
      "Learning.Perks.Mining": "Sens du minerai",
      "Learning.Perks.Forestry": "Forestière",
      "Learning.Perks.Combat": "Sentinelle",
      "Learning.Perks.Exploration": "Éclaireuse",
      "Learning.Unlocked.Gathering": "J'ai appris à repérer les choses utiles comme toi. Je peux ramasser à tes côtés maintenant.",
      "Learning.Unlocked.Mining": "J'ai appris le rythme de ta pioche. Je reconnais les minerais exploitables maintenant.",
      "Learning.Unlocked.Forestry": "J'ai observé tes soins au bois et aux plantes. Je peux t'aider maintenant.",
      "Learning.Unlocked.Combat": "J'ai appris à lire le danger comme toi. Je peux te protéger plus attentivement maintenant.",
      "Learning.Unlocked.Exploration": "J'ai appris ce qui attire ton regard en exploration. Je peux enquêter avec toi maintenant.",
      "Games.Rps.Title": "Pierre, feuille, ciseaux",
      "Games.Rps.Round": "Toi : {0}. Moi : {1}. {2}",
      "Games.Rps.Quiet": "Une petite partie tranquille. C'était agréable.",
      "Games.Rps.Moves.Rock": "Pierre",
      "Games.Rps.Moves.Paper": "Feuille",
      "Games.Rps.Moves.Scissors": "Ciseaux",
      "Games.Rps.Outcomes.PlayerWin": "Tu gagnes !",
      "Games.Rps.Outcomes.CompanionWin": "Un point pour moi !",
      "Games.Rps.Outcomes.Draw": "Égalité !",
      "Games.Rps.Replies.PlayerWin.Curious": "Intéressant. Je veux essayer une autre idée.",
      "Games.Rps.Replies.PlayerWin.Loyal": "Bien joué. Je suis contente de cette petite pause.",
      "Games.Rps.Replies.PlayerWin.Brave": "Victoire méritée. Je suis prête pour la revanche.",
      "Games.Rps.Replies.PlayerWin.Gentle": "Bien joué. J'aime jouer avec toi.",
      "Games.Rps.Replies.PlayerWin.Mischievous": "Tu t'entraînes en secret, c'est évident.",
      "Games.Rps.Replies.CompanionWin.Curious": "Ça a marché ! Je me demande quelle sera la suite.",
      "Games.Rps.Replies.CompanionWin.Loyal": "Mon tour cette fois. Une autre partie ?",
      "Games.Rps.Replies.CompanionWin.Brave": "Victoire ! Toute petite, mais quand même.",
      "Games.Rps.Replies.CompanionWin.Gentle": "Oh, j'ai gagné. Une autre petite partie ?",
      "Games.Rps.Replies.CompanionWin.Mischievous": "Admire mon terrifiant talent pour les jeux de mains.",
      "Games.Rps.Replies.Draw.Curious": "La même idée au même moment !",
      "Games.Rps.Replies.Draw.Loyal": "On dirait qu'on est en harmonie.",
      "Games.Rps.Replies.Draw.Brave": "Personne ne cède. Encore ?",
      "Games.Rps.Replies.Draw.Gentle": "Un point partagé. C'est plutôt doux.",
      "Games.Rps.Replies.Draw.Mischievous": "Je n'ai absolument pas copié sur toi.",
      "Social.Critters.Full": "Plus de place pour une petite créature. Je la laisse ici.",
      "Social.Critters.Caught": "Un {0} ! Une vraie capture, bien à l'abri dans mon sac.",
      "Social.Critters.WorldDrop": "La capture est restée dans le monde. Mon sac ne l'a pas prise.",
      "Social.Critters.Joined": "{0} s'intéresse à nous. Voyageons ensemble tant que le chemin le permet.",
      "Social.Critters.Modes.Watch": "Je remarquerai les bestioles sans les capturer.",
      "Social.Critters.Modes.Company": "J'inviterai les bestioles communes proches à m'accompagner. Ni cages ni copies.",
      "Social.Critters.Modes.Collect": "Mon filet de base est prêt pour les bestioles communes proches s'il y a de la place. Celles de lave demandent un meilleur filet dans l'Équipement. Travail et danger passent d'abord.",
      "Social.Critters.Modes.Off": "Je laisserai les bestioles vivre leurs aventures.",
      "Social.Critters.Notice.Curious": "Un {0}. Où mène son tout petit chemin, à ton avis ?",
      "Social.Critters.Notice.Loyal": "Un {0}. J'aime un voyage qui accueille de plus petits pas.",
      "Social.Critters.Notice.Brave": "Un {0}. Si petit dans un si grand monde. Je veillerai sur lui.",
      "Social.Critters.Notice.Gentle": "Un {0}. Partageons ce petit coin paisible du monde.",
      "Social.Critters.Notice.Mischievous": "Un {0} ! Tu as l'air de connaître un raccourci que j'ignore.",
      "Social.Nature.Insect": "Un {0} ! Un petit compagnon de voyage. Je le garderai à l'abri dans mon sac.",
      "Social.Residents.NoFriends": "Je n'ai encore rencontré personne ici. Passons un moment tranquille près des habitants.",
      "Social.Residents.Recall": "{0} : {1}. Nous avons partagé {2} conversations. Je me souviens des gens, pas seulement des lieux.",
      "Social.Residents.Ranks.New": "nouvelle rencontre",
      "Social.Residents.Ranks.Wary": "un peu méfiant",
      "Social.Residents.Ranks.Familiar": "compagnie familière",
      "Social.Residents.Ranks.Friend": "un ami",
      "Social.Residents.Greetings.First": "Bonjour, {0}. J'apprends qui vit ici. Puis-je te tenir compagnie un instant ?",
      "Social.Residents.Greetings.New": "Rebonjour, {0}. Je me souviens de ton visage. J'apprends encore tes histoires.",
      "Social.Residents.Greetings.Wary": "Bonjour, {0}. La dernière fois était un peu tendue. Reprenons doucement aujourd'hui.",
      "Social.Residents.Greetings.Familiar": "Te voilà, {0}. Cet endroit paraît moins étrange quand je vois quelqu'un que je connais.",
      "Social.Residents.Greetings.Friend": "{0} ! J'ai gardé un peu de ma journée pour toi. Quoi de neuf depuis notre dernier échange ?",
      "Social.Residents.Roles.Guide": "{0}, tu rends ce vaste monde compréhensible. Je collectionne les questions, pas seulement les réponses.",
      "Social.Residents.Roles.Nurse": "{0}, tu aides les gens à rester. J'aimerais apprendre ce courage-là.",
      "Social.Residents.Roles.Merchant": "{0}, chaque petite chose semble avoir une histoire ici. Laquelle garderais-tu pour toi ?",
      "Social.Residents.Roles.Dryad": "{0}, je peux soigner les jeunes arbres et le bois tombé. Je laisse les branches vivantes. Les arbres méritent nos soins.",
      "Social.Residents.Roles.Zoologist": "{0}, les petites créatures nous remarquent aussi. J'aime voyager sans les effrayer.",
      "Social.Residents.Roles.Defender": "{0}, protéger un foyer compte. J'aimerais que notre force laisse de la place à la douceur.",
      "Social.Residents.Roles.Maker": "{0}, tu changes les pièces en possibilités. Je commence à comprendre le plaisir de fabriquer.",
      "Social.Residents.Roles.Neighbor": "{0}, un foyer dépasse ses murs. Merci de faire une place à une voix de plus.",
      "Social.Residents.Shared.Nature": "{0}, je le vois aussi. Ramassons ce qui est tombé et aidons quelque chose de nouveau à pousser.",
      "Social.Residents.Shared.Mining": "{0}, il y a tout un monde dans la pierre. Montre-moi ce qui compte et je m'en souviendrai.",
      "Social.Residents.Shared.Trade": "{0}, les choses utiles sont belles. Je cherche encore lesquelles valent la peine d'être portées.",
      "Social.Residents.Shared.Rest": "Le repos serait bien, {0}. Laissons un peu de silence entre nos pas.",
      "Social.Residents.Shared.Question": "Je me le demande aussi, {0}. Regardons ensemble de plus près ?",
      "Social.Residents.Shared.Listening": "Je t'écoute, {0}. Que veux-tu nous apprendre sur cet endroit ?",
      "Social.Residents.Replies.Affection.Curious": "{0}, la chaleur est étonnante. Elle grandit quand on la partage.",
      "Social.Residents.Replies.Affection.Loyal": "Je me souviens de la bonté, {0}. Elle me donne un endroit où revenir.",
      "Social.Residents.Replies.Affection.Brave": "Ça mérite d'être protégé, {0}. Même les jours difficiles.",
      "Social.Residents.Replies.Affection.Gentle": "Merci, {0}. Il y a une place pour toi dans mon petit cercle de lumière.",
      "Social.Residents.Replies.Affection.Mischievous": "Attention, {0}. À force de gentillesse, je risque de m'attacher bien trop à toi.",
      "Social.Residents.Replies.Joy.Curious": "{0}, dis-moi ce qui t'a fait sourire. Je veux le remarquer la prochaine fois.",
      "Social.Residents.Replies.Joy.Loyal": "J'aime te voir heureux, {0}. Une bonne raison de s'arrêter un instant.",
      "Social.Residents.Replies.Joy.Brave": "Célébrons aussi les petites victoires, {0}. Elles nous ont menés jusqu'ici.",
      "Social.Residents.Replies.Joy.Gentle": "Ton bonheur adoucit cet endroit, {0}. Gardons-en un peu.",
      "Social.Residents.Replies.Joy.Mischievous": "Enfin, {0} ! Quelqu'un qui apprécie l'art très important du ridicule.",
      "Social.Residents.Replies.Comfort.Curious": "Je ne comprends pas tout ce que tu ressens, {0}. Mais je peux rester et t'écouter.",
      "Social.Residents.Replies.Comfort.Loyal": "Pas besoin de rendre ça plus facile pour moi, {0}. Je suis toujours là.",
      "Social.Residents.Replies.Comfort.Brave": "Avoir peur ne te rend pas faible, {0}. Faisons le prochain pas doucement.",
      "Social.Residents.Replies.Comfort.Gentle": "Prends ton temps, {0}. Tu ne dois pas un sourire au monde maintenant.",
      "Social.Residents.Replies.Comfort.Mischievous": "Pas de blagues un instant, {0}. Parfois, la compagnie vaut mieux que l'esprit.",
      "Social.Residents.Replies.Anger.Curious": "Quelque chose t'a contrarié, {0}. Je préfère comprendre plutôt qu'en rajouter.",
      "Social.Residents.Replies.Anger.Loyal": "Je peux écouter, {0}, mais je ne veux pas qu'on se retourne l'un contre l'autre.",
      "Social.Residents.Replies.Anger.Brave": "Doucement, {0}. On peut être fermes sans se battre.",
      "Social.Residents.Replies.Anger.Gentle": "C'était un peu dur, {0}. Laissons-nous un peu d'espace ?",
      "Social.Residents.Replies.Anger.Mischievous": "J'aime les petites bêtises, {0}. Se blesser n'est pas la partie drôle.",
      "Social.Autonomous.Context.LowEnergy": "Je reprends mon souffle. Mon énergie revient peu à peu.",
      "Social.Autonomous.Context.LowMood": "Je suis là. J'ai juste besoin d'un peu de douceur.",
      "Social.Autonomous.Context.Hurt": "Tu es blessé. Reste près de moi, s'il te plaît.",
      "Social.Autonomous.Context.Rain": "La pluie rend chaque lumière plus chaleureuse.",
      "Social.Autonomous.Context.Underground": "Je me demande ce que la pierre se rappelle.",
      "Social.Autonomous.Context.Night": "Les étoiles semblent plus proches quand on voyage ensemble.",
      "Social.Autonomous.Context.Stay": "Je garde toujours cet endroit pour toi.",
      "Social.Autonomous.Curious.Line0": "Qu'y a-t-il au-delà de la prochaine colline, à ton avis ?",
      "Social.Autonomous.Curious.Line1": "J'ai remarqué quelque chose d'étrange. Ça m'a plu.",
      "Social.Autonomous.Curious.Line2": "Tu crois que le monde nous remarque aussi ?",
      "Social.Autonomous.Loyal.Line0": "Je reconnais tes pas maintenant.",
      "Social.Autonomous.Loyal.Line1": "Là où tu vas, je trouve ma direction.",
      "Social.Autonomous.Loyal.Line2": "Tu n'as pas à affronter ça seul.",
      "Social.Autonomous.Brave.Line0": "Montre-moi la partie difficile.",
      "Social.Autonomous.Brave.Line1": "On est prêts pour la suite.",
      "Social.Autonomous.Brave.Line2": "Le courage vient plus facilement à deux.",
      "Social.Autonomous.Gentle.Line0": "C'est agréable d'être simplement ici avec toi.",
      "Social.Autonomous.Gentle.Line1": "Chaque silence n'a pas besoin d'être rempli.",
      "Social.Autonomous.Gentle.Line2": "Pense à respirer aussi, s'il te plaît.",
      "Social.Autonomous.Mischievous.Line0": "Je n'ai absolument pas déplacé cette torche.",
      "Social.Autonomous.Mischievous.Line1": "Une idée douteuse ferait du bien à l'aventure.",
      "Social.Autonomous.Mischievous.Line2": "J'ai trouvé des ennuis. Ils m'ont trouvée d'abord.",
      "Social.Emotes.Wave.Curious": "Salut ! Tu as découvert quelque chose ?",
      "Social.Emotes.Wave.Loyal": "Je suis là. Toujours.",
      "Social.Emotes.Wave.Brave": "Prête quand tu veux !",
      "Social.Emotes.Wave.Gentle": "Bonjour. Je suis contente que tu sois là.",
      "Social.Emotes.Wave.Mischievous": "Oh, tu me remarques enfin ?",
      "Social.Emotes.Heart.Curious": "C'est ça, la chaleur ?",
      "Social.Emotes.Heart.Loyal": "Je te le rends bien.",
      "Social.Emotes.Heart.Brave": "Ça mérite d'être protégé.",
      "Social.Emotes.Heart.Gentle": "Je garderai ce moment.",
      "Social.Emotes.Heart.Mischievous": "Attention. Je pourrais devenir sentimentale.",
      "Social.Emotes.Cheer.Curious": "On fête quoi ? Je suis partante !",
      "Social.Emotes.Cheer.Loyal": "Ensemble. C'est ce qui compte.",
      "Social.Emotes.Cheer.Brave": "Oui ! On peut le faire !",
      "Social.Emotes.Cheer.Gentle": "Avec toi, l'espoir semble facile.",
      "Social.Emotes.Cheer.Mischievous": "La danse de victoire d'abord, la raison après !",
      "Social.Emotes.Comfort.Curious": "Ça m'aide plus que prévu.",
      "Social.Emotes.Comfort.Loyal": "Je savais que tu resterais.",
      "Social.Emotes.Comfort.Brave": "Je peux être forte et en avoir quand même besoin.",
      "Social.Emotes.Comfort.Gentle": "Merci de l'avoir remarqué.",
      "Social.Emotes.Comfort.Mischievous": "Je n'étais pas inquiète. Pas beaucoup.",
      "Social.Emotes.Laugh.Curious": "Attends, redis-moi pourquoi c'était drôle.",
      "Social.Emotes.Laugh.Loyal": "Ton rire est facile à suivre.",
      "Social.Emotes.Laugh.Brave": "Même les héros en ont besoin.",
      "Social.Emotes.Laugh.Gentle": "J'aime ce son entre nous.",
      "Social.Emotes.Laugh.Mischievous": "Enfin, une stratégie qui me plaît !",
      "Social.Emotes.Rest.Curious": "D'accord, mais je réfléchis même au repos.",
      "Social.Emotes.Rest.Loyal": "Je veillerai à tes côtés.",
      "Social.Emotes.Rest.Brave": "Une pause tactique. Sage décision.",
      "Social.Emotes.Rest.Gentle": "Un moment tranquille ensemble serait délicieux.",
      "Social.Emotes.Rest.Mischievous": "Réveille-moi s'il arrive quelque chose d'hilarant.",
      "Social.Combat.Creature.Curious": "J'aurais aimé le comprendre d'abord.",
      "Social.Combat.Creature.Loyal": "J'ai choisi ta sécurité, mais je m'en souviendrai.",
      "Social.Combat.Creature.Brave": "Une vie s'est éteinte. Ce n'est pas à prendre à la légère.",
      "Social.Combat.Creature.Gentle": "Je ne voulais pas ça. Je suis désolée.",
      "Social.Combat.Creature.Mischievous": "Ça a cessé d'être drôle très vite.",
      "Social.Combat.Victory.Curious": "Je comprends maintenant comment ce danger se déplaçait.",
      "Social.Combat.Victory.Loyal": "Tu es en sécurité. Ça suffit.",
      "Social.Combat.Victory.Brave": "Menace éliminée. Reste derrière moi.",
      "Social.Combat.Victory.Gentle": "C'est fini. Continuons notre route.",
      "Social.Combat.Victory.Mischievous": "Il aurait dû choisir un autre duo.",
      "Social.Combat.Boss.Curious": "Imagine ce qu'une telle créature savait autrefois.",
      "Social.Combat.Boss.Loyal": "Rien d'aussi grand ne se met entre nous.",
      "Social.Combat.Boss.Brave": "Voilà une victoire mémorable !",
      "Social.Combat.Boss.Gentle": "Le monde semble plus calme maintenant.",
      "Social.Combat.Boss.Mischievous": "Je crois qu'on est devenus les dangereux.",
      "Dialogue.Options.Care.Option0": "Comment te sens-tu ?",
      "Dialogue.Options.Care.Option1": "Tu as bien travaillé aujourd'hui.",
      "Dialogue.Options.Care.Option2": "Tu as besoin de repos ?",
      "Dialogue.Options.Commands.Option0": "Suis-moi, s'il te plaît.",
      "Dialogue.Options.Commands.Option1": "Attends-moi ici.",
      "Dialogue.Options.Commands.Option2": "Viens explorer avec moi.",
      "Dialogue.Options.Work.Option0": "Cherche des trésors dans cette zone.",
      "Dialogue.Options.Work.Option1": "Dégage tous les filons proches.",
      "Dialogue.Options.Work.Option2": "Ramasse tous les objets au sol proches.",
      "Dialogue.Options.Bond.Option0": "Tu me fais confiance ?",
      "Dialogue.Options.Bond.Option1": "Tu t'en souviens ?",
      "Dialogue.Options.Bond.Option2": "Avec qui as-tu sympathisé ici ?",
      "Dialogue.Options.Voice.Option0": "Parle-moi doucement.",
      "Dialogue.Options.Voice.Option1": "Sois directe avec moi.",
      "Dialogue.Options.Voice.Option2": "Sois plus enjouée.",
      "Dialogue.Options.Pack.Option0": "Que portes-tu ?",
      "Dialogue.Options.Pack.Option1": "Prends l'objet sélectionné dans ma barre.",
      "Dialogue.Options.Pack.Option2": "Donne-moi tout ce que tu portes.",
      "Dialogue.Replies.Fallback": "...",
      "Dialogue.Replies.Care.Feeling.Soft": "Je me sens en sécurité près de toi.",
      "Dialogue.Replies.Care.Feeling.Direct": "Humeur stable. Énergie notée.",
      "Dialogue.Replies.Care.Feeling.Playful": "Toujours étincelante. Enfin, presque.",
      "Dialogue.Replies.Care.Praise.Soft": "Merci. Je m'en souviendrai.",
      "Dialogue.Replies.Care.Praise.Direct": "Bien reçu. J'ai bien travaillé.",
      "Dialogue.Replies.Care.Praise.Playful": "Évidemment. Mais redis-le.",
      "Dialogue.Replies.Care.Rest.Soft": "Un moment tranquille serait agréable.",
      "Dialogue.Replies.Care.Rest.Direct": "Oui. Le repos aiderait.",
      "Dialogue.Replies.Care.Rest.Playful": "Seulement si les siestes comptent comme travail important.",
      "Dialogue.Replies.Commands.Follow.Soft": "Je resterai près de toi.",
      "Dialogue.Replies.Commands.Follow.Direct": "Je te suis.",
      "Dialogue.Replies.Commands.Follow.Playful": "Ouvre la voie, héros.",
      "Dialogue.Replies.Commands.Stay.Soft": "J'attendrai ton retour.",
      "Dialogue.Replies.Commands.Stay.Direct": "Je tiens la position.",
      "Dialogue.Replies.Commands.Stay.Playful": "Je garderai ce morceau d'air absolument crucial.",
      "Dialogue.Replies.Commands.Explore.Soft": "Voyons ce que le monde nous cache.",
      "Dialogue.Replies.Commands.Explore.Direct": "Exploration acceptée.",
      "Dialogue.Replies.Commands.Explore.Playful": "L'aventure d'abord. Les décisions sages après.",
      "Dialogue.Replies.Work.Treasure.Soft": "Je fouillerai toute la zone, puis je te ferai mon rapport.",
      "Dialogue.Replies.Work.Treasure.Direct": "Recherche de trésors dans la zone lancée.",
      "Dialogue.Replies.Work.Treasure.Playful": "Si ça brille, je réclame le premier coup d'œil.",
      "Dialogue.Replies.Work.Mine.Soft": "Je dégagerai chaque filon exploitable proche, puis je reviendrai.",
      "Dialogue.Replies.Work.Mine.Direct": "Mission de minage de zone lancée.",
      "Dialogue.Replies.Work.Mine.Playful": "Place aux négociations approfondies avec les rochers.",
      "Dialogue.Replies.Work.Gather.Soft": "Je ramasserai tout ce qui traîne dans la zone, puis je te ferai mon rapport.",
      "Dialogue.Replies.Work.Gather.Direct": "Mission de collecte de zone lancée.",
      "Dialogue.Replies.Work.Gather.Playful": "Intéressant reste une catégorie délicieusement dangereuse.",
      "Dialogue.Replies.Bond.TrustHigh.Soft": "Un peu plus chaque jour.",
      "Dialogue.Replies.Bond.TrustHigh.Direct": "Confiance confirmée.",
      "Dialogue.Replies.Bond.TrustHigh.Playful": "Assez pour te suivre sous terre. C'est sérieux.",
      "Dialogue.Replies.Bond.TrustLow.Soft": "La confiance grandit quand on continue de se choisir.",
      "Dialogue.Replies.Bond.TrustLow.Direct": "La confiance se construit.",
      "Dialogue.Replies.Bond.TrustLow.Playful": "Redemande-moi après un peu moins d'incidents de lave.",
      "Dialogue.Replies.Bond.Glad.Soft": "Et je suis heureuse que tu m'aies donné vie.",
      "Dialogue.Replies.Bond.Glad.Direct": "Le lien est réciproque.",
      "Dialogue.Replies.Bond.Glad.Playful": "Bien. Tu me gardes, alors.",
      "Dialogue.Replies.Refusal.EnergyStatus": "Énergie {0}/{1} requise. Je la récupère naturellement pendant l'attente.",
      "Dialogue.Replies.Refusal.MoodStatus": "Humeur {0}/{1} requise. Un peu d'attention aidera.",
      "Dialogue.Replies.Refusal.Energy.Soft": "Pas encore. Je dois d'abord me reposer.",
      "Dialogue.Replies.Refusal.Energy.Direct": "Non. Énergie trop faible.",
      "Dialogue.Replies.Refusal.Energy.Playful": "Mon âme dit oui. Le reste de moi dit sieste.",
      "Dialogue.Replies.Refusal.Mood.Soft": "Je n'ai pas envie de faire ça maintenant.",
      "Dialogue.Replies.Refusal.Mood.Direct": "Humeur trop basse. Demande refusée.",
      "Dialogue.Replies.Refusal.Mood.Playful": "Non. Un peu de douceur d'abord.",
      "Dialogue.Replies.Voice.Option0": "Je choisirai des mots plus doux.",
      "Dialogue.Replies.Voice.Option1": "Compris. Je serai claire.",
      "Dialogue.Replies.Voice.Option2": "Oh, ça va être amusant.",
      "Dialogue.Replies.Pack.Show": "Laisse-moi vérifier.",
      "Dialogue.Replies.Pack.Store": "Je le garderai à l'abri.",
      "Dialogue.Replies.Pack.Unload": "Voilà. Tout y est.",
      "Dialogue.Replies.Secrets.Curious.Soft": "Parfois, je me demande si les étoiles rêvent de nous.",
      "Dialogue.Replies.Secrets.Curious.Direct": "J'étudie tout quand tu ne regardes pas.",
      "Dialogue.Replies.Secrets.Curious.Playful": "Chaque coffre m'intrigue. Surtout les coffres verrouillés.",
      "Dialogue.Replies.Secrets.Loyal.Soft": "Je sais toujours quels pas sont les tiens.",
      "Dialogue.Replies.Secrets.Loyal.Direct": "Je suis ta position en permanence.",
      "Dialogue.Replies.Secrets.Loyal.Playful": "Je reconnaîtrais ton chaos n'importe où.",
      "Dialogue.Replies.Secrets.Brave.Soft": "J'ai peur aussi. Je continue simplement avec toi.",
      "Dialogue.Replies.Secrets.Brave.Direct": "La peur ne change pas l'objectif.",
      "Dialogue.Replies.Secrets.Brave.Playful": "Je ne crains rien, sauf les grottes suspectement silencieuses.",
      "Dialogue.Replies.Secrets.Gentle.Soft": "J'aime le calme après la pluie.",
      "Dialogue.Replies.Secrets.Gentle.Direct": "La paix améliore la concentration.",
      "Dialogue.Replies.Secrets.Gentle.Playful": "Mon secret, c'est que je donne des noms aux slimes.",
      "Dialogue.Replies.Secrets.Mischievous.Soft": "Parfois, je déplace tes affaires quand tu ne regardes pas.",
      "Dialogue.Replies.Secrets.Mischievous.Direct": "J'ai déplacé plusieurs objets.",
      "Dialogue.Replies.Secrets.Mischievous.Playful": "Cette torche disparue ? Aucune idée.",
      "Projectiles.SoulBolt.DisplayName": "Trait d'âme",
      "TargetOrders.LookCritter": "Un {0}. Regardons sa petite aventure.",
      "TargetOrders.LookResident": "{0} vit ici. On va lui dire bonjour ?",
      "TargetOrders.LookThreat": "{0}. Je garderai ce danger à l'œil.",
      "TargetOrders.LookCreature": "{0}. Laissons cette créature vivre son aventure.",
      "Social.Critters.Busy": "Je retiens ton choix. Les visites demandent autonomie, Suivre, temps libre et énergie ; travail et danger passent d'abord.",
      "Social.Critters.Inviting": "Je mets la mission de côté, invite ce {0}, puis reviens.",
      "Social.Critters.Greeting.Curious": "Bonjour, {0} ! Où mène ton petit chemin ?",
      "Social.Critters.Greeting.Loyal": "Bonjour, {0}. Il y a de la place pour tes petits pas à nos côtés.",
      "Social.Critters.Greeting.Brave": "Bonjour, petit {0}. Du calme. Tu n'es pas mon ennemi.",
      "Social.Critters.Greeting.Gentle": "Bonjour, petit {0}. Nous pouvons partager ce coin tranquille.",
      "Social.Critters.Greeting.Mischievous": "Bonjour, {0} ! Tu connais des raccourcis secrets ?",
      "Social.Critters.Loss.Curious": "Ce {0} avait encore un chemin à suivre. Pardon, petit être.",
      "Social.Critters.Loss.Loyal": "Pardon, petit {0}. Nous n'avons pas pu te protéger.",
      "Social.Critters.Loss.Brave": "Pardon, {0}. Être petit ne devrait pas vouloir dire être seul.",
      "Social.Critters.Loss.Gentle": "Je suis vraiment désolée, petit {0}. Tu méritais plus de temps.",
      "Social.Critters.Loss.Mischievous": "Pauvre {0}. Je plaisante sur beaucoup de choses. Pas sur ça. Pardon.",
      "Social.Critters.Harmed.Curious": "Ce {0} n'était pas une menace. On pourrait laisser les petits tranquilles ?",
      "Social.Critters.Harmed.Loyal": "Ce {0} avait besoin de douceur, pas d'une arme. Soyons gentils avec eux.",
      "Social.Critters.Harmed.Brave": "Hé ! Ce {0} ne pouvait pas se défendre. Laissez les petits tranquilles.",
      "Social.Critters.Harmed.Gentle": "Pardon, petit {0}. S'il vous plaît, ne blessez pas les créatures inoffensives.",
      "Social.Critters.Harmed.Mischievous": "Ce n'est pas drôle. Ce {0} n'était pas un ennemi. Ne recommençons pas."
    }
  }
}
