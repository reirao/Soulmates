      "Games.Rps.Title": "Kamień, papier, nożyce",
      "Games.Rps.Round": "Ty: {0}. Ja: {1}. {2}",
      "Games.Rps.Quiet": "Mała spokojna runda. Było miło.",
      "Games.Rps.Moves.Rock": "Kamień",
      "Games.Rps.Moves.Paper": "Papier",
      "Games.Rps.Moves.Scissors": "Nożyce",
      "Games.Rps.Outcomes.PlayerWin": "Wygrywasz!",
      "Games.Rps.Outcomes.CompanionWin": "Punkt dla mnie!",
      "Games.Rps.Outcomes.Draw": "Remis!",
      "Games.Rps.Replies.PlayerWin.Curious": "Ciekawe. Chcę sprawdzić inny pomysł.",
      "Games.Rps.Replies.PlayerWin.Loyal": "Dobra gra. Cieszę się, że zrobiliśmy tę małą przerwę.",
      "Games.Rps.Replies.PlayerWin.Brave": "Uczciwa wygrana. Jestem gotowa na rewanż.",
      "Games.Rps.Replies.PlayerWin.Gentle": "Świetnie. Lubię z tobą grać.",
      "Games.Rps.Replies.PlayerWin.Mischievous": "Najwyraźniej trenujesz w tajemnicy.",
      "Games.Rps.Replies.CompanionWin.Curious": "Zadziałało! Ciekawe, co będzie dalej.",
      "Games.Rps.Replies.CompanionWin.Loyal": "Tym razem moja kolej. Jeszcze jedna runda?",
      "Games.Rps.Replies.CompanionWin.Brave": "Zwycięstwo! Malutkie, ale jednak.",
      "Games.Rps.Replies.CompanionWin.Gentle": "O, wygrałam. Jeszcze mała runda?",
      "Games.Rps.Replies.CompanionWin.Mischievous": "Podziwiaj mój przerażający talent do zabaw dłońmi.",
      "Games.Rps.Replies.Draw.Curious": "Ten sam pomysł w tej samej chwili!",
      "Games.Rps.Replies.Draw.Loyal": "Chyba nadajemy na tych samych falach.",
      "Games.Rps.Replies.Draw.Brave": "Nikt nie ustępuje. Jeszcze raz?",
      "Games.Rps.Replies.Draw.Gentle": "Wspólny punkt. To całkiem miłe uczucie.",
      "Games.Rps.Replies.Draw.Mischievous": "Absolutnie cię nie naśladowałam.",
      "Social.Critters.NeedNet": "Potrzebuję siatki na owady w Wyposażeniu, aby łapać zwierzątka.",
      "Social.Critters.Full": "Nie ma miejsca na kolejne zwierzątko. Zostawię je tutaj.",
      "Social.Critters.Caught": "{0}! Prawdziwy połów, bezpieczny w moim plecaku.",
      "Social.Critters.WorldDrop": "Połów został w świecie. Mój plecak go nie przyjął.",
      "Social.Critters.Joined": "{0} interesuje się nami. Podróżujmy razem, dopóki droga na to pozwala.",
      "Social.Critters.Modes.Watch": "Będę zauważać zwierzątka, nie łapiąc ich.",
      "Social.Critters.Modes.Company": "Zaproszę pobliskie zwykłe zwierzątka do towarzystwa. Bez klatek i kopii.",
      "Social.Critters.Modes.Collect": "Użyję siatki na pobliskie zwykłe zwierzątka, jeśli jest miejsce. Praca i zagrożenia mają pierwszeństwo.",
      "Social.Critters.Modes.Off": "Zostawię zwierzątka ich własnym przygodom.",
      "Social.Critters.Notice.Curious": "{0}. Dokąd, jak myślisz, prowadzi jego mała ścieżka?",
      "Social.Critters.Notice.Loyal": "{0}. Lubię podróż, w której jest miejsce na mniejsze kroki.",
      "Social.Critters.Notice.Brave": "{0}. Tak małe stworzenie w tak wielkim świecie. Dopilnuję go.",
      "Social.Critters.Notice.Gentle": "{0}. Możemy dzielić ten spokojny zakątek świata.",
      "Social.Critters.Notice.Mischievous": "{0}! Wyglądasz, jakbyś znało skrót, którego ja nie znam.",
      "Social.Nature.Insect": "{0}! Mały towarzysz podróży. Zadbam o niego, gdy jest w moim plecaku.",
      "Social.Residents.NoFriends": "Jeszcze nikogo tu nie znam. Spędźmy chwilę spokojnie obok mieszkańców.",
      "Social.Residents.Recall": "{0}: {1}. Wspólne rozmowy: {2}. Pamiętam ludzi, nie tylko miejsca.",
      "Social.Residents.Ranks.New": "nowa znajomość",
      "Social.Residents.Ranks.Wary": "trochę nieufnie",
      "Social.Residents.Ranks.Familiar": "znajome towarzystwo",
      "Social.Residents.Ranks.Friend": "przyjaźń",
      "Social.Residents.Greetings.First": "Witaj, {0}. Poznaję tutejszych mieszkańców. Mogę dotrzymać ci przez chwilę towarzystwa?",
      "Social.Residents.Greetings.New": "Witaj ponownie, {0}. Pamiętam twoją twarz. Wciąż poznaję twoje historie.",
      "Social.Residents.Greetings.Wary": "Witaj, {0}. Ostatnio było trochę ostro. Może dziś zaczniemy łagodniej?",
      "Social.Residents.Greetings.Familiar": "Tu jesteś, {0}. To miejsce jest mniej obce, gdy widzę kogoś znajomego.",
      "Social.Residents.Greetings.Friend": "{0}! Mam dla ciebie kawałek mojego dnia. Co się wydarzyło od naszej ostatniej rozmowy?",
      "Social.Residents.Roles.Guide": "{0}, dzięki tobie wielki świat staje się zrozumiały. Zbieram pytania, nie tylko odpowiedzi.",
      "Social.Residents.Roles.Nurse": "{0}, pomagasz ludziom zostać z nami. Chcę nauczyć się takiej odwagi.",
      "Social.Residents.Roles.Merchant": "{0}, każdy drobiazg ma tu chyba swoją historię. Co zatrzymasz dla siebie?",
      "Social.Residents.Roles.Dryad": "{0}, mogę dbać o sadzonki i opadłe drewno. Zostawię żywe gałęzie. Drzewa zasługują na troskę.",
      "Social.Residents.Roles.Zoologist": "{0}, małe stworzenia też nas zauważają. Lubię podróżować, nie strasząc ich.",
      "Social.Residents.Roles.Defender": "{0}, ochrona domu jest ważna. Chcę, by nasza siła zostawiała miejsce na życzliwość.",
      "Social.Residents.Roles.Maker": "{0}, zamieniasz części w możliwości. Zaczynam rozumieć radość tworzenia.",
      "Social.Residents.Roles.Neighbor": "{0}, dom to więcej niż ściany. Dziękuję za miejsce dla jeszcze jednego głosu.",
      "Social.Residents.Shared.Nature": "{0}, też to widzę. Możemy zebrać to, co opadło, i pomóc czemuś nowemu wyrosnąć.",
      "Social.Residents.Shared.Mining": "{0}, w kamieniu jest cały świat. Pokaż mi, co ważne, a zapamiętam.",
      "Social.Residents.Shared.Trade": "{0}, przydatne rzeczy są piękne. Wciąż wybieram, które warto nieść.",
      "Social.Residents.Shared.Rest": "Odpoczynek brzmi dobrze, {0}. Zostawmy trochę ciszy między krokami.",
      "Social.Residents.Shared.Question": "Też się zastanawiam, {0}. Przyjrzymy się razem bliżej?",
      "Social.Residents.Shared.Listening": "Słucham, {0}. Co powinniśmy wiedzieć o tym miejscu?",
      "Social.Residents.Replies.Affection.Curious": "{0}, ciepło to ciekawa rzecz. Rośnie, gdy się nim dzielisz.",
      "Social.Residents.Replies.Affection.Loyal": "Pamiętam życzliwość, {0}. Daje mi miejsce, do którego mogę wrócić.",
      "Social.Residents.Replies.Affection.Brave": "Warto tego chronić, {0}. Nawet w trudne dni.",
      "Social.Residents.Replies.Affection.Gentle": "Dziękuję, {0}. Jest dla ciebie miejsce w moim małym kręgu światła.",
      "Social.Residents.Replies.Affection.Mischievous": "Uważaj, {0}. Jeszcze trochę życzliwości i przywiążę się do ciebie aż za bardzo.",
      "Social.Residents.Replies.Joy.Curious": "{0}, powiedz, co wywołało twój uśmiech. Chcę to zauważyć następnym razem.",
      "Social.Residents.Replies.Joy.Loyal": "Lubię widzieć twoją radość, {0}. To dobry powód, by na chwilę przystanąć.",
      "Social.Residents.Replies.Joy.Brave": "Świętujmy też małe zwycięstwa, {0}. Dzięki nim jesteśmy tutaj.",
      "Social.Residents.Replies.Joy.Gentle": "Twoja radość czyni to miejsce łagodniejszym, {0}. Zachowajmy jej trochę.",
      "Social.Residents.Replies.Joy.Mischievous": "Nareszcie, {0}! Ktoś docenia tę ważną sztukę wygłupiania się.",
      "Social.Residents.Replies.Comfort.Curious": "Nie rozumiem wszystkiego, co czujesz, {0}. Ale mogę zostać i słuchać.",
      "Social.Residents.Replies.Comfort.Loyal": "Nie musisz ułatwiać mi tego, {0}. Nadal jestem tutaj.",
      "Social.Residents.Replies.Comfort.Brave": "Strach nie czyni cię słabym, {0}. Możemy zrobić kolejny krok powoli.",
      "Social.Residents.Replies.Comfort.Gentle": "Daj sobie czas, {0}. Nie musisz teraz uśmiechać się do świata.",
      "Social.Residents.Replies.Comfort.Mischievous": "Przez chwilę bez żartów, {0}. Czasem towarzystwo jest ważniejsze niż dowcip.",
      "Social.Residents.Replies.Anger.Curious": "Coś cię zdenerwowało, {0}. Wolę zrozumieć niż dolać oliwy do ognia.",
      "Social.Residents.Replies.Anger.Loyal": "Mogę słuchać, {0}, ale nie chcę, żebyśmy zwrócili się przeciw sobie.",
      "Social.Residents.Replies.Anger.Brave": "Spokojnie, {0}. Możemy być stanowczy bez walki.",
      "Social.Residents.Replies.Anger.Gentle": "To było ostre, {0}. Dajmy sobie trochę przestrzeni.",
      "Social.Residents.Replies.Anger.Mischievous": "Lubię psoty, {0}. Krzywdzenie siebie nawzajem nie jest zabawne.",
      "Social.Autonomous.Context.LowEnergy": "Możemy na chwilę zwolnić?",
      "Social.Autonomous.Context.LowMood": "Jestem tutaj. Potrzebuję tylko odrobiny życzliwości.",
      "Social.Autonomous.Context.Hurt": "Masz rany. Proszę, zostań blisko mnie.",
      "Social.Autonomous.Context.Rain": "Deszcz sprawia, że każde światło wydaje się cieplejsze.",
      "Social.Autonomous.Context.Underground": "Ciekawe, co pamięta kamień.",
      "Social.Autonomous.Context.Night": "Gwiazdy wydają się bliższe, gdy podróżujemy razem.",
      "Social.Autonomous.Context.Stay": "Nadal pilnuję tego miejsca dla ciebie.",
      "Social.Autonomous.Curious.Line0": "Co jest za następnym wzgórzem, jak myślisz?",
      "Social.Autonomous.Curious.Line1": "Zauważyłam coś dziwnego. Spodobało mi się.",
      "Social.Autonomous.Curious.Line2": "Myślisz, że świat też nas zauważa?",
      "Social.Autonomous.Loyal.Line0": "Znam już twoje kroki.",
      "Social.Autonomous.Loyal.Line1": "Tam, gdzie idziesz, mam swój kierunek.",
      "Social.Autonomous.Loyal.Line2": "Nie musisz mierzyć się z tym samotnie.",
      "Social.Autonomous.Brave.Line0": "Wskaż mi najtrudniejszą część.",
      "Social.Autonomous.Brave.Line1": "Jesteśmy gotowi na to, co nadejdzie.",
      "Social.Autonomous.Brave.Line2": "Odwaga przychodzi łatwiej w towarzystwie.",
      "Social.Autonomous.Gentle.Line0": "Miło po prostu być tutaj z tobą.",
      "Social.Autonomous.Gentle.Line1": "Nie każdą cichą chwilę trzeba wypełniać.",
      "Social.Autonomous.Gentle.Line2": "Pamiętaj też o oddechu, proszę.",
      "Social.Autonomous.Mischievous.Line0": "Zdecydowanie nie przesunęłam tej pochodni.",
      "Social.Autonomous.Mischievous.Line1": "Przygodzie przydałby się jeden wątpliwy pomysł.",
      "Social.Autonomous.Mischievous.Line2": "Znalazłam kłopoty. Najpierw one znalazły mnie.",
      "Social.Emotes.Wave.Curious": "Cześć! Jest jakieś odkrycie?",
      "Social.Emotes.Wave.Loyal": "Jestem tutaj. Zawsze.",
      "Social.Emotes.Wave.Brave": "Gotowa na twój znak!",
      "Social.Emotes.Wave.Gentle": "Witaj. Cieszę się, że jesteś tutaj.",
      "Social.Emotes.Wave.Mischievous": "O, teraz mnie zauważasz?",
      "Social.Emotes.Heart.Curious": "Czy tak odczuwa się ciepło?",
      "Social.Emotes.Heart.Loyal": "Wzajemnie, z całego serca.",
      "Social.Emotes.Heart.Brave": "Warto tego chronić.",
      "Social.Emotes.Heart.Gentle": "Zachowam tę chwilę.",
      "Social.Emotes.Heart.Mischievous": "Uważaj. Mogę się rozczulić.",
      "Social.Emotes.Cheer.Curious": "Co świętujemy? Wchodzę w to!",
      "Social.Emotes.Cheer.Loyal": "Razem. To jest najważniejsze.",
      "Social.Emotes.Cheer.Brave": "Tak! Damy radę!",
      "Social.Emotes.Cheer.Gentle": "Przy tobie nadzieja przychodzi łatwo.",
      "Social.Emotes.Cheer.Mischievous": "Najpierw taniec zwycięstwa, potem powód!",
      "Social.Emotes.Comfort.Curious": "To pomaga bardziej, niż myślałam.",
      "Social.Emotes.Comfort.Loyal": "Wiedziałam, że zostaniesz.",
      "Social.Emotes.Comfort.Brave": "Mogę być silna i nadal tego potrzebować.",
      "Social.Emotes.Comfort.Gentle": "Dziękuję za zauważenie.",
      "Social.Emotes.Comfort.Mischievous": "Nie martwiłam się. Za bardzo.",
      "Social.Emotes.Laugh.Curious": "Czekaj, wyjaśnij mi jeszcze raz, dlaczego to było śmieszne.",
      "Social.Emotes.Laugh.Loyal": "Łatwo podążać za twoim śmiechem.",
      "Social.Emotes.Laugh.Brave": "Nawet bohaterowie tego potrzebują.",
      "Social.Emotes.Laugh.Gentle": "Lubię ten dźwięk między nami.",
      "Social.Emotes.Laugh.Mischievous": "Nareszcie strategia dla mnie!",
      "Social.Emotes.Rest.Curious": "Dobrze, ale myślę nawet podczas odpoczynku.",
      "Social.Emotes.Rest.Loyal": "Będę czuwać przy tobie.",
      "Social.Emotes.Rest.Brave": "Przerwa taktyczna. Rozsądnie.",
      "Social.Emotes.Rest.Gentle": "Spokojna chwila razem brzmi pięknie.",
      "Social.Emotes.Rest.Mischievous": "Obudź mnie, jeśli zdarzy się coś zabawnego.",
      "Social.Combat.Creature.Curious": "Chciałabym najpierw to zrozumieć.",
      "Social.Combat.Creature.Loyal": "Wybrałam twoje bezpieczeństwo, ale zapamiętam to.",
      "Social.Combat.Creature.Brave": "Życie się skończyło. Nie powinniśmy tego lekceważyć.",
      "Social.Combat.Creature.Gentle": "Nie chciałam tego. Przykro mi.",
      "Social.Combat.Creature.Mischievous": "To bardzo szybko przestało być zabawne.",
      "Social.Combat.Victory.Curious": "Teraz rozumiem, jak poruszało się to zagrożenie.",
      "Social.Combat.Victory.Loyal": "Jesteś bezpiecznie. To wystarczy.",
      "Social.Combat.Victory.Brave": "Zagrożenie minęło. Zostań za mną.",
      "Social.Combat.Victory.Gentle": "To koniec. Ruszajmy dalej.",
      "Social.Combat.Victory.Mischievous": "Trzeba było wybrać inną parę.",
      "Social.Combat.Boss.Curious": "Wyobraź sobie, co kiedyś wiedziało takie stworzenie.",
      "Social.Combat.Boss.Loyal": "Nic tak wielkiego nie stanie między nami.",
      "Social.Combat.Boss.Brave": "To zwycięstwo warto zapamiętać!",
      "Social.Combat.Boss.Gentle": "Świat wydaje się teraz cichszy.",
      "Social.Combat.Boss.Mischievous": "Chyba teraz to my jesteśmy niebezpieczni.",
      "Dialogue.Options.Care.Option0": "Jak się czujesz?",
      "Dialogue.Options.Care.Option1": "Dobrze ci dziś poszło.",
      "Dialogue.Options.Care.Option2": "Potrzebujesz odpoczynku?",
      "Dialogue.Options.Commands.Option0": "Proszę, idź za mną.",
      "Dialogue.Options.Commands.Option1": "Zaczekaj tu na mnie.",
      "Dialogue.Options.Commands.Option2": "Chodź odkrywać ze mną.",
      "Dialogue.Options.Work.Option0": "Poszukaj skarbów w tym obszarze.",
      "Dialogue.Options.Work.Option1": "Wykop wszystkie pobliskie żyły rudy.",
      "Dialogue.Options.Work.Option2": "Zbierz wszystkie luźne przedmioty w pobliżu.",
      "Dialogue.Options.Bond.Option0": "Ufasz mi?",
      "Dialogue.Options.Bond.Option1": "Pamiętasz?",
      "Dialogue.Options.Bond.Option2": "Z kim się tu zaprzyjaźniłaś?",
      "Dialogue.Options.Voice.Option0": "Mów do mnie łagodnie.",
      "Dialogue.Options.Voice.Option1": "Mów do mnie wprost.",
      "Dialogue.Options.Voice.Option2": "Żartuj częściej.",
      "Dialogue.Options.Pack.Option0": "Co niesiesz?",
      "Dialogue.Options.Pack.Option1": "Weź wybrany przedmiot z mojego paska.",
      "Dialogue.Options.Pack.Option2": "Oddaj mi wszystko, co niesiesz.",
      "Dialogue.Replies.Fallback": "...",
      "Dialogue.Replies.Care.Feeling.Soft": "Przy tobie czuję się bezpiecznie.",
      "Dialogue.Replies.Care.Feeling.Direct": "Nastrój stabilny. Energia odnotowana.",
      "Dialogue.Replies.Care.Feeling.Playful": "Nadal lśnię. Przeważnie.",
      "Dialogue.Replies.Care.Praise.Soft": "Dziękuję. Zapamiętam.",
      "Dialogue.Replies.Care.Praise.Direct": "Przyjęte. Dobrze mi poszło.",
      "Dialogue.Replies.Care.Praise.Playful": "Oczywiście. Ale powiedz to jeszcze raz.",
      "Dialogue.Replies.Care.Rest.Soft": "Spokojna chwila brzmi pięknie.",
      "Dialogue.Replies.Care.Rest.Direct": "Tak. Odpoczynek pomoże.",
      "Dialogue.Replies.Care.Rest.Playful": "Tylko jeśli drzemki liczą się jako ważna praca.",
      "Dialogue.Replies.Commands.Follow.Soft": "Zostanę blisko.",
      "Dialogue.Replies.Commands.Follow.Direct": "Podążam.",
      "Dialogue.Replies.Commands.Follow.Playful": "Prowadź, bohaterze.",
      "Dialogue.Replies.Commands.Stay.Soft": "Poczekam na twój powrót.",
      "Dialogue.Replies.Commands.Stay.Direct": "Utrzymuję pozycję.",
      "Dialogue.Replies.Commands.Stay.Playful": "Będę pilnować tego niezwykle ważnego kawałka powietrza.",
      "Dialogue.Replies.Commands.Explore.Soft": "Zobaczmy, co skrywa świat.",
      "Dialogue.Replies.Commands.Explore.Direct": "Odkrywanie przyjęte.",
      "Dialogue.Replies.Commands.Explore.Playful": "Najpierw przygoda. Rozsądne decyzje później.",
      "Dialogue.Replies.Work.Treasure.Soft": "Przeszukam cały obszar, potem zdam relację.",
      "Dialogue.Replies.Work.Treasure.Direct": "Rozpoczęto poszukiwanie skarbów w obszarze.",
      "Dialogue.Replies.Work.Treasure.Playful": "Jeśli błyszczy, chcę spojrzeć pierwsza.",
      "Dialogue.Replies.Work.Mine.Soft": "Wykopię wszystkie dostępne żyły w pobliżu, potem wrócę.",
      "Dialogue.Replies.Work.Mine.Direct": "Rozpoczęto kopanie w obszarze.",
      "Dialogue.Replies.Work.Mine.Playful": "Czas na dogłębne negocjacje ze skałami.",
      "Dialogue.Replies.Work.Gather.Soft": "Zbiorę wszystkie luźne rzeczy w obszarze, potem zdam relację.",
      "Dialogue.Replies.Work.Gather.Direct": "Rozpoczęto zbieranie w obszarze.",
      "Dialogue.Replies.Work.Gather.Playful": "Ciekawe to nadal cudownie niebezpieczna kategoria.",
      "Dialogue.Replies.Bond.TrustHigh.Soft": "Coraz bardziej, każdego dnia.",
      "Dialogue.Replies.Bond.TrustHigh.Direct": "Zaufanie potwierdzone.",
      "Dialogue.Replies.Bond.TrustHigh.Playful": "Na tyle, by iść za tobą pod ziemię. To poważna sprawa.",
      "Dialogue.Replies.Bond.TrustLow.Soft": "Zaufanie rośnie, gdy wciąż wybieramy siebie nawzajem.",
      "Dialogue.Replies.Bond.TrustLow.Direct": "Zaufanie się tworzy.",
      "Dialogue.Replies.Bond.TrustLow.Playful": "Zapytaj ponownie po mniejszej liczbie wypadków z lawą.",
      "Dialogue.Replies.Bond.Glad.Soft": "A ja cieszę się, że twoje wezwanie dało mi życie.",
      "Dialogue.Replies.Bond.Glad.Direct": "Więź jest wzajemna.",
      "Dialogue.Replies.Bond.Glad.Playful": "Dobrze. Zostawiasz mnie przy sobie.",
      "Dialogue.Replies.Refusal.EnergyStatus": "Energia {0}/{1} wymagana. Odzyskam ją naturalnie, gdy poczekamy.",
      "Dialogue.Replies.Refusal.MoodStatus": "Nastrój {0}/{1} wymagany. Trochę troski pomoże.",
      "Dialogue.Replies.Refusal.Energy.Soft": "Jeszcze nie. Najpierw muszę odpocząć.",
      "Dialogue.Replies.Refusal.Energy.Direct": "Nie. Za mało energii.",
      "Dialogue.Replies.Refusal.Energy.Playful": "Dusza mówi tak. Reszta mnie mówi drzemka.",
      "Dialogue.Replies.Refusal.Mood.Soft": "Nie mam teraz na to ochoty.",
      "Dialogue.Replies.Refusal.Mood.Direct": "Zbyt niski nastrój. Prośba odrzucona.",
      "Dialogue.Replies.Refusal.Mood.Playful": "Nie. Najpierw trochę życzliwości.",
      "Dialogue.Replies.Voice.Option0": "Wybiorę łagodniejsze słowa.",
      "Dialogue.Replies.Voice.Option1": "Rozumiem. Będę mówić jasno.",
      "Dialogue.Replies.Voice.Option2": "O, będzie zabawnie.",
      "Dialogue.Replies.Pack.Show": "Sprawdzę.",
      "Dialogue.Replies.Pack.Store": "Przechowam to bezpiecznie.",
      "Dialogue.Replies.Pack.Unload": "Proszę. Wszystko się zgadza.",
      "Dialogue.Replies.Secrets.Curious.Soft": "Czasem zastanawiam się, czy gwiazdy o nas śnią.",
      "Dialogue.Replies.Secrets.Curious.Direct": "Badam wszystko, kiedy nie patrzysz.",
      "Dialogue.Replies.Secrets.Curious.Playful": "Mam pytania o każdą skrzynię. Zwłaszcza zamkniętą.",
      "Dialogue.Replies.Secrets.Loyal.Soft": "Zawsze wiem, które kroki są twoje.",
      "Dialogue.Replies.Secrets.Loyal.Direct": "Stale śledzę twoją pozycję.",
      "Dialogue.Replies.Secrets.Loyal.Playful": "Rozpoznam twój chaos wszędzie.",
      "Dialogue.Replies.Secrets.Brave.Soft": "Też się boję. Po prostu i tak idę z tobą.",
      "Dialogue.Replies.Secrets.Brave.Direct": "Strach nie zmienia celu.",
      "Dialogue.Replies.Secrets.Brave.Playful": "Nic się nie boję, oprócz podejrzanie cichych jaskiń.",
      "Dialogue.Replies.Secrets.Gentle.Soft": "Lubię ciszę po deszczu.",
      "Dialogue.Replies.Secrets.Gentle.Direct": "Spokój poprawia skupienie.",
      "Dialogue.Replies.Secrets.Gentle.Playful": "Mój sekret: nadaję imiona slime'om.",
      "Dialogue.Replies.Secrets.Mischievous.Soft": "Czasem przestawiam twoje rzeczy, kiedy nie patrzysz.",
      "Dialogue.Replies.Secrets.Mischievous.Direct": "Przemieszczono kilka przedmiotów.",
      "Dialogue.Replies.Secrets.Mischievous.Playful": "Ta zaginiona pochodnia? Nie mam pojęcia.",
      "Projectiles.SoulBolt.DisplayName": "Pocisk duszy",
      "TargetOrders.LookCritter": "{0}. Przyjrzyjmy się jego małej przygodzie.",
      "TargetOrders.LookResident": "{0} mieszka tutaj. Przywitamy się?",
      "TargetOrders.LookThreat": "{0}. Będę obserwować to zagrożenie.",
      "TargetOrders.LookCreature": "{0}. Pozwólmy temu stworzeniu przeżyć własną przygodę.",
      "Social.Critters.Busy": "Zapamiętam twój wybór. Wizyty wymagają autonomii, Podążaj, wolnego czasu i energii; praca i zagrożenia mają pierwszeństwo.",
      "Social.Critters.Inviting": "Odłożę zadanie, zaproszę to stworzenie ({0}) i wrócę.",
      "Social.Critters.Greeting.Curious": "Cześć, {0}! Dokąd prowadzi twoja mała ścieżka?",
      "Social.Critters.Greeting.Loyal": "Cześć, {0}. Obok nas jest miejsce na małe kroki.",
      "Social.Critters.Greeting.Brave": "Cześć, małe stworzenie ({0}). Spokojnie. Nie jesteś moim wrogiem.",
      "Social.Critters.Greeting.Gentle": "Cześć, małe stworzenie ({0}). Możemy dzielić to ciche miejsce.",
      "Social.Critters.Greeting.Mischievous": "Cześć, {0}! Pokażesz mi jakieś tajne skróty?",
      "Social.Critters.Loss.Curious": "To stworzenie ({0}) miało jeszcze dokąd pójść. Przepraszam, maleństwo.",
      "Social.Critters.Loss.Loyal": "Przepraszam, małe stworzenie ({0}). Nie udało się nam cię ochronić.",
      "Social.Critters.Loss.Brave": "Przepraszam, {0}. Bycie małym nie powinno oznaczać samotności.",
      "Social.Critters.Loss.Gentle": "Tak mi przykro, {0}. Twój czas nie powinien kończyć się tak szybko.",
      "Social.Critters.Loss.Mischievous": "Biedne stworzenie ({0}). Żartuję z wielu rzeczy. Nie z tego. Przepraszam.",
      "Social.Critters.Harmed.Curious": "To stworzenie ({0}) nie było zagrożeniem. Możemy zostawić maluchy w spokoju?",
      "Social.Critters.Harmed.Loyal": "To stworzenie ({0}) potrzebowało życzliwości, nie broni. Traktujmy je łagodnie.",
      "Social.Critters.Harmed.Brave": "Hej! To stworzenie ({0}) nie mogło się bronić. Zostawcie maluchy w spokoju.",
      "Social.Critters.Harmed.Gentle": "Przepraszam, małe stworzenie ({0}). Proszę, nie krzywdźcie nieszkodliwych zwierząt.",
      "Social.Critters.Harmed.Mischievous": "To nie jest zabawne. To stworzenie ({0}) nie było wrogiem. Nie róbmy tego znowu."
    }
  }
