    Dialogue: {
      Options: {
        Care: {
          Option0: Wie fühlst du dich?
          Option1: Das hast du heute gut gemacht.
          Option2: Brauchst du eine Pause?
        }
        Commands: {
          Option0: Bitte folge mir.
          Option1: Warte hier auf mich.
          Option2: Komm mit mir auf Erkundung.
        }
        Work: {
          Option0: Suche dieses Gebiet nach Schätzen ab.
          Option1: Baue jede Erzader in der Nähe ab.
          Option2: Sammle jeden losen Gegenstand in der Nähe.
        }
        Bond: {
          Option0: Vertraust du mir?
          Option1: Erzähl mir etwas über dich.
          Option2: Ich bin froh, dass du hier bist.
        }
        Voice: {
          Option0: Sprich sanft mit mir.
          Option1: Sprich direkt mit mir.
          Option2: Sei etwas verspielter.
        }
        Pack: {
          Option0: Was trägst du bei dir?
          Option1: Nimm den ausgewählten Gegenstand.
          Option2: Gib mir alles, was du trägst.
        }
      }
      Replies: {
        Fallback: ...
        Care: {
          Feeling: {
            Soft: Bei dir fühle ich mich sicher.
            Direct: Laune stabil. Energie erfasst.
            Playful: Funkelt noch. Größtenteils.
          }
          Praise: {
            Soft: Danke. Daran werde ich mich erinnern.
            Direct: Bestätigt. Gute Arbeit geleistet.
            Playful: Natürlich. Aber sag es ruhig noch einmal.
          }
          Rest: {
            Soft: Ein ruhiger Moment klingt wunderbar.
            Direct: Ja. Eine Pause wäre hilfreich.
            Playful: Nur wenn Nickerchen als wichtige Arbeit zählen.
          }
        }
        Commands: {
          Follow: {
            Soft: Ich bleibe in deiner Nähe.
            Direct: Folge dir.
            Playful: Vorwärts, Held.
          }
          Stay: {
            Soft: Ich warte auf deine Rückkehr.
            Direct: Halte die Position.
            Playful: Ich bewache dieses äußerst wichtige Stück Luft.
          }
          Explore: {
            Soft: Sehen wir nach, was die Welt verbirgt.
            Direct: Erkundung bestätigt.
            Playful: Erst das Abenteuer. Vernünftige Entscheidungen später.
          }
        }
        Work: {
          Treasure: {
            Soft: Ich durchsuche das ganze Gebiet und melde mich danach.
            Direct: Gebietssuche nach Schätzen gestartet.
            Playful: Wenn es glänzt, darf ich es zuerst ansehen.
          }
          Mine: {
            Soft: Ich räume jede abbaubare Erzader in der Nähe und kehre dann zurück.
            Direct: Bergbauauftrag im Gebiet gestartet.
            Playful: Zeit für umfassende Verhandlungen mit den Steinen.
          }
          Gather: {
            Soft: Ich sammle alles Lose in diesem Gebiet und melde mich danach.
            Direct: Sammelauftrag im Gebiet gestartet.
            Playful: Interessant bleibt eine wunderbar gefährliche Kategorie.
          }
        }
        Bond: {
          TrustHigh: {
            Soft: Jeden Tag ein wenig mehr.
            Direct: Vertrauen bestätigt.
            Playful: Genug, um dir unter die Erde zu folgen. Das ist ernst.
          }
          TrustLow: {
            Soft: Vertrauen wächst, wenn wir uns immer wieder füreinander entscheiden.
            Direct: Vertrauen bildet sich.
            Playful: Frag nach weniger Zwischenfällen mit Lava noch einmal.
          }
          Glad: {
            Soft: Und ich bin froh, dass du mich ins Dasein gerufen hast.
            Direct: Die Bindung beruht auf Gegenseitigkeit.
            Playful: Gut. Du behältst mich also.
          }
        }
        Refusal: {
          Energy: {
            Soft: Noch nicht. Ich muss mich zuerst ausruhen.
            Direct: Nein. Energie zu niedrig.
            Playful: Meine Seele sagt ja. Der Rest von mir sagt Nickerchen.
          }
          Mood: {
            Soft: Danach ist mir gerade nicht.
            Direct: Laune zu niedrig. Anfrage abgelehnt.
            Playful: Nö. Erst ein bisschen Freundlichkeit.
          }
        }
        Voice: {
          Option0: Ich werde sanftere Worte wählen.
          Option1: Verstanden. Ich werde deutlich sein.
          Option2: Oh, das wird Spaß machen.
        }
        Pack: {
          Show: Lass mich nachsehen.
          Store: Ich bewahre es sicher auf.
          Unload: Hier. Alles ist vollständig.
        }
        Secrets: {
          Curious: {
            Soft: Manchmal frage ich mich, ob die Sterne von uns träumen.
            Direct: Ich untersuche alles, wenn du nicht hinsiehst.
            Playful: Ich habe Fragen zu jeder Truhe. Besonders zu verschlossenen.
          }
          Loyal: {
            Soft: Ich erkenne deine Schritte immer.
            Direct: Ich behalte deine Position ständig im Blick.
            Playful: Dein Chaos würde ich überall wiedererkennen.
          }
          Brave: {
            Soft: Ich fürchte mich auch. Ich gehe trotzdem mit dir weiter.
            Direct: Angst verändert das Ziel nicht.
            Playful: Ich bin furchtlos. Außer in verdächtig stillen Höhlen.
          }
          Gentle: {
            Soft: Ich mag die Stille nach dem Regen.
            Direct: Frieden verbessert die Konzentration.
            Playful: Mein Geheimnis ist, dass ich den Schleimen Namen gebe.
          }
          Mischievous: {
            Soft: Manchmal verrücke ich deine Sachen, wenn du nicht hinsiehst.
            Direct: Ich habe mehrere Gegenstände umplatziert.
            Playful: Die fehlende Fackel? Keine Ahnung.
          }
        }
      }
    }
  }
}
