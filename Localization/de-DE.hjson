Mods: {
	Soulmates: {
		Items: {
			Soulcore: {
				DisplayName: Seelenkern
				Tooltip:
					'''
					Ein wiederverwendbares Werkzeug zum Erschaffen neuer Gefährten
					Benutzen oder rechtsklicken, um den Seelenschöpfer zu öffnen
					'''
			}

			BlankSigil: {
				DisplayName: Leeres Siegel
				Tooltip: Ein leeres Gefäß, das auf eine Seele wartet
			}

			SoulboundSigil: {
				DisplayName: Seelengebundenes Siegel
				Tooltip: Ein einzigartiger Gefährte ruht darin
			}

			StarfinderBell: {
				DisplayName: Sternensucherglocke
				Tooltip:
					'''
					Stimmt einen beschworenen Gefährten auf ferne Schätze ein
					Benutzen zum Ausrüsten  |  Rechtsklick zum Ablegen
					'''
			}

			DelverCharm: {
				DisplayName: Tiefengänger-Talisman
				Tooltip:
					'''
					Erhöht Abbauradius und -tempo eines beschworenen Gefährten
					Benutzen zum Ausrüsten  |  Rechtsklick zum Ablegen
					'''
			}

			HearthRibbon: {
				DisplayName: Herdfeuerband
				Tooltip:
					'''
					Erhöht Sammelreichweite und Tragkraft eines beschworenen Gefährten
					Benutzen zum Ausrüsten  |  Rechtsklick zum Ablegen
					'''
			}
		}

