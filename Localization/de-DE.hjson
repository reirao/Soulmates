Mods: {
	Soulmates: {
		Social.Critters.DirectBusy: Für diesen Besuch brauche ich aktive Autonomie und einen ruhigen Moment ohne Gefahr oder offene Frage.
		Enums.CompanionQuickAction.Pause: Pausieren
		Enums.CompanionQuickAction.Resume: Fortsetzen
		Enums.CompanionQuickAction.Abort: Abbrechen
		Enums.TalkCategory.Items: Gegenstände
		Dialogue.Options.Items.Option0: Was trägst du aus dieser Kategorie?
		Dialogue.Options.Items.Option1: Wofür ist das gut?
		Dialogue.Options.Items.Option2: Erinnert dich das an etwas?
		Items.Topics.All: Alles
		Items.Topics.Food: Nahrung
		Items.Topics.Ores: Erze
		Items.Topics.Tools: Werkzeuge
		Items.Topics.Weapons: Waffen
		Items.Topics.Recovery: Erholung
		Items.Topics.Materials: Materialien
		Items.Topics.Critters: Kleintiere
		Items.Topics.Other: Sonstiges
		Items.Empty: Ich habe gerade nichts in der Kategorie {0} dabei.
		Items.Carrying: Bei {0} habe ich: {1}.
		Items.Example: "{0} gehört zu {1}."
		Items.Uses.Food: Nahrung gibt einen Sättigungsbuff. Für einen längeren Ausflug lohnt sich ein Vorrat.
		Items.Uses.Ores: Im Ofen werden Erze zu Barren. Die richtige Spitzhacke bleibt wichtig.
		Items.Uses.Tools: Werkzeuge ermöglichen unterschiedliche Arbeiten. Zum Einfangen braucht es ein echtes Netz.
		Items.Uses.Weapons: Das ist Kampfausrüstung, kein Baumaterial. Ich bewahre es für dich auf.
		Items.Uses.Recovery: Das hilft bei Leben, Mana oder mit einem Buff. Die echte Wirkung zählt mehr als die Farbe.
		Items.Uses.Materials: Das ist Bau- oder Handwerksmaterial. Stationen und Rezepte bestimmen, was daraus wird.
		Items.Uses.Critters: Das ist ein eingefangenes Wesen. Freigelassen wird es wieder ein echter Bewohner.
		Items.Uses.Other: Schauen wir auf den Tooltip oder fragen den Guide, bevor wir entscheiden.
		Stories.ItemFound: Wir haben zusammen {0} eingesammelt.
		Stories.CritterMet: Wir haben ein Wesen begrüßt: {0}.
		Stories.CritterLost: Wir haben ein Wesen sterben sehen: {0}. Ich habe das Kleine nicht vergessen.
		Stories.Beginning: Unsere gemeinsame Geschichte beginnt erst.
		Stories.Intro.Line0: Erinnerst du dich daran?
		Stories.Intro.Line1: Ein kleiner Moment ist mir geblieben.
		Stories.Intro.Line2: Diesen Teil unserer Reise habe ich behalten.
		Stories.Reflection.Work: Für mich war es nicht nur ein weiterer Gegenstand. Wir haben etwas gemeinsam getan.
		Stories.Reflection.Protection: Einen Moment lang war am wichtigsten, aufeinander aufzupassen.
		Stories.Reflection.Company: Kleine Begegnungen können einen Ort weniger leer machen.
		Stories.Reflection.Beginning: Da begann unsere gemeinsame Zeit.
		Stories.Reflection.Growth: Das gehört dazu, wie wir zusammen gewachsen sind.
		Stories.Personality.Curious: Was werden wir wohl als Nächstes entdecken?
		Stories.Personality.Loyal: Ich bin froh, dass ich bei dir war.
		Stories.Personality.Brave: Ich würde wieder mit dir gehen.
		Stories.Personality.Gentle: Auch kleine Dinge sind eine Erinnerung wert.
		Stories.Personality.Mischievous: Kein schlechtes kleines Abenteuer, oder?
		Stories.Playful: Ein winziges Kapitel. Unbedingt behalten!
		Stories.Present.Threat: Da ist ein Gegner in der Nähe: {0}. Behalten wir ihn im Blick.
		Stories.Present.Resident: "{0} ist in der Nähe. Wir sind hier nicht allein."
		Stories.Present.Creature: Ich sehe ein Wesen in unserer Nähe: {0}.
		Stories.Present.Item: Hier liegt {0} auf dem Boden.
		Stories.Present.Quiet: Gerade ist es ruhig um uns. Schön, dass du hier bist.
		Stories.Told: "{0}"
		WorkControl.Pause: Ich pausiere und behalte den Auftrag. Beschützen kann ich dich weiterhin.
		WorkControl.Resume: Ich mache mit dem behaltenen Auftrag weiter oder helfe, wenn keiner da ist.
		WorkControl.Abort: Auftrag abgebrochen. Ich bleibe bei dir, bis du fortsetzt oder etwas Neues befiehlst.
		WorkControl.Status: Arbeit pausiert
		UI.CompanionWheel.Actions.Pause: Arbeit pausieren (Auftrag behalten)
		UI.CompanionWheel.Actions.Resume: Arbeit fortsetzen
		UI.CompanionWheel.Actions.Abort: Auftrag abbrechen
		Social.Critters.CatchSelected: Ich lege den bisherigen Auftrag beiseite und versuche, das Wesen {0} mit meinem Netz zu fangen.
		Conversation: {
			Later: Natürlich. Wir können später reden.
			Company: {
				Heading: Was wünschst du dir?
				Question: {
					Soft: Welche Art Gesellschaft würde dir gerade guttun?
					Direct: Was würde dir gerade am meisten helfen?
					Playful: Hilfreicher Sidekick, Spaßpartner oder ein kleiner stiller Schatten?
				}
				Choices: {
					First: Sammle immer die losen Sachen in der Nähe.
					Second: Lass uns Spaß haben. Sei verspielt!
					Third: Ein wenig sanfte Gesellschaft, bitte.
					Later: Lass uns später reden.
				}
				Reply: {
					Direct: Verstanden. Lose Sachen in der Nähe sind mein Job. Auch meine Worte werden klarer.
					Playful: Abenteuerpartner also! Ich verspreche absolut vernünftige Mengen an Unfug.
					Soft: Ich bin da. Ein wenig sanfter, ein wenig näher.
				}
			}
			Wallet: {
				Heading: Etwas für dich
				Choices: {
					First: Danke! Ich nehme die Münzen.
					Second: Spare weiter für uns.
					Third: Schau uns an, Schatzjäger!
					Later: Nicht jetzt. Bewahre sie gut auf.
				}
				Delivered: Hier, für dich! Alles sicher in deinen Taschen.
				Partial: Hier, für dich! Was nicht hineinpasst, behalte ich sicher bei mir.
				Full: Deine Taschen sind voll. Keine Sorge, jede Münze bleibt sicher bei mir.
				Saving: Verstanden. Unsere Ersparnisse bleiben bei mir.
				TreasureHunters: Eine Zwei-Seelen-Schatzexpedition! Ich passe auf unser kleines glänzendes Vermögen auf.
				Curious: {
					Line0: Hier, für dich! Ich habe {0} gefunden. Was könnte man dafür bekommen?
					Line1: Die kleinen Funde haben sich summiert: {0}. Möchtest du sie?
				}
				Loyal: {
					Line0: Hier, für dich! Ich habe {0} gut aufbewahrt. Möchtest du sie?
					Line1: Eine Kleinigkeit für deine Reise: {0}. Soll ich sie dir geben?
				}
				Brave: {
					Line0: Hier, für dich! Unsere Abenteuer haben {0} eingebracht. Möchtest du sie?
					Line1: Bereit für das nächste Abenteuer? Ich habe {0} für Vorräte.
				}
				Gentle: {
					Line0: Hier, für dich! Eine kleine Freude, {0}. Darf ich sie dir geben?
					Line1: Du hast genug getragen. Ich habe {0} für dich gespart.
				}
				Mischievous: {
					Line0: Hier, für dich! {0}, legal erworben. Fast nur ein Scherz. Möchtest du sie?
					Line1: Meine Taschen klimpern: {0}. Deine könnten es auch!
				}
			}
			Chatter: {
				Soft: {
					Line0: Keine Eile. Ich bin gern hier bei dir.
					Line1: Auch die kleinen Entdeckungen zählen.
					Line2: Ich höre zu. Wir gehen einen Schritt nach dem anderen.
				}
				Direct: {
					Line0: Ich bleibe nah und halte nach nützlichen Funden Ausschau.
					Line1: Bereit, sobald du es bist.
					Line2: Eine Aufgabe nach der anderen. Wir kommen voran.
				}
				Playful: {
					Line0: Offiziell winzig. Inoffiziell ein ausgezeichneter Abenteuerpartner.
					Line1: Wenn wir einen Schatz finden, darf ich ihn benennen!
					Line2: Gleiches Team, andere Taschen. Finden wir etwas Glänzendes.
				}
			}
		}
		Items: {
			Soulcore: {
				DisplayName: Seelenkern
				Tooltip:
					'''
					Ein wiederverwendbares Werkzeug zum Erschaffen neuer Gefährten
					Benutzen oder rechtsklicken, um den Seelenschöpfer zu öffnen
					'''
			}

			BlankSigil: {
				DisplayName: Leeres Siegel
				Tooltip: Ein leeres Gefäß, das auf eine Seele wartet
			}

			SoulboundSigil: {
				DisplayName: Seelengebundenes Siegel
				Tooltip: Ein einzigartiger Gefährte ruht darin
			}

			StarfinderBell: {
				DisplayName: Sternensucherglocke
				Tooltip:
					'''
					Stimmt einen beschworenen Gefährten auf ferne Schätze ein
					Benutzen zum Ausrüsten  |  Rechtsklick zum Ablegen
					'''
			}

			DelverCharm: {
				DisplayName: Tiefengänger-Talisman
				Tooltip:
					'''
					Erhöht Abbauradius und -tempo eines beschworenen Gefährten
					Benutzen zum Ausrüsten  |  Rechtsklick zum Ablegen
					'''
			}

			HearthRibbon: {
				DisplayName: Herdfeuerband
				Tooltip:
					'''
					Erhöht Sammelreichweite und Tragkraft eines beschworenen Gefährten
					Benutzen zum Ausrüsten  |  Rechtsklick zum Ablegen
					'''
			}
		}

