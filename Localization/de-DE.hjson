						Loyal: Ich sehe dich gern glücklich, {0}. Dafür lohnt sich eine kleine Pause.
						Brave: Kleine Siege sollten wir auch feiern, {0}. Sie haben uns bis hierher getragen.
						Gentle: Deine Freude macht diesen Ort sanfter, {0}. Lass uns ein wenig davon behalten.
						Mischievous: Endlich, {0}! Jemand versteht das wichtige Geschäft des Albernseins.
					}

					Comfort: {
						Curious: Ich verstehe nicht alles, was du fühlst, {0}. Aber ich kann bleiben, während du es erzählst.
						Loyal: Du musst es für mich nicht leichter machen, {0}. Ich bin noch da.
						Brave: Angst macht dich nicht schwach, {0}. Den nächsten Schritt können wir langsam gehen.
						Gentle: Lass dir Zeit, {0}. Du schuldest der Welt gerade kein Lächeln.
						Mischievous: Einen Moment keine Witze, {0}. Manche Dinge brauchen mehr Gesellschaft als Schlagfertigkeit.
					}

					Anger: {
						Curious: Etwas hat dich geärgert, {0}. Ich würde es lieber verstehen, als es lauter zu machen.
						Loyal: Ich kann zuhören, {0}, aber wir sollen uns nicht gegeneinander wenden.
						Brave: Langsam, {0}. Wir können bestimmt sein, ohne daraus einen Streit zu machen.
						Gentle: Das war schroff, {0}. Können wir einander etwas Platz lassen?
						Mischievous: Ein wenig Unfug mag ich, {0}. Einander weh zu tun ist nicht der lustige Teil.
					}
				}
			}

			Autonomous: {
				Context: {
					LowEnergy: Könnten wir einen Moment langsamer machen?
					LowMood: Ich bin da. Ich brauche nur etwas Freundlichkeit.
					Hurt: Du bist verletzt. Bitte bleib in meiner Nähe.
					Rain: Im Regen fühlt sich jedes Licht wärmer an.
					Underground: Ich frage mich, woran sich der Stein erinnert.
					Night: Die Sterne wirken näher, wenn wir zusammen reisen.
					Stay: Ich halte diesen Ort immer noch für dich.
				}

				Curious: {
					Line0: Was glaubst du, liegt hinter dem nächsten Hügel?
					Line1: Mir ist etwas Seltsames aufgefallen. Es gefiel mir.
					Line2: Glaubst du, die Welt bemerkt auch uns?
				}

				Loyal: {
					Line0: Ich kenne inzwischen deine Schritte.
					Line1: Wo du hingehst, habe ich eine Richtung.
					Line2: Du musst dich dem nicht allein stellen.
				}

				Brave: {
					Line0: Zeig mir den schwierigen Teil.
					Line1: Wir sind bereit für das, was als Nächstes kommt.
					Line2: Mut ist leichter in Gesellschaft.
				}

				Gentle: {
					Line0: Es ist schön, einfach bei dir zu sein.
					Line1: Nicht jeder stille Moment muss gefüllt werden.
					Line2: Denk bitte auch daran, zu atmen.
				}

				Mischievous: {
					Line0: Ich habe diese Fackel ganz bestimmt nicht verrückt.
					Line1: Das Abenteuer könnte eine fragwürdige Idee vertragen.
					Line2: Ich habe Ärger gefunden. Er hat angefangen.
				}
			}

			Emotes: {
				Wave: {
					Curious: Hallo! Hast du etwas entdeckt?
					Loyal: Ich bin hier. Immer.
					Brave: Bereit, wenn du es bist!
					Gentle: Hallo. Ich bin froh, dass du da bist.
					Mischievous: Ach, jetzt bemerkst du mich?
				}

				Heart: {
					Curious: Fühlt sich Wärme so an?
					Loyal: Das gebe ich dir zurück.
					Brave: Das ist es wert, beschützt zu werden.
					Gentle: Diesen Moment bewahre ich.
					Mischievous: Vorsicht. Ich werde noch sentimental.
				}

				Cheer: {
					Curious: Was feiern wir? Ich bin dabei!
					Loyal: Zusammen. Das ist der wichtige Teil.
					Brave: Ja! Wir schaffen das!
					Gentle: Bei dir sieht Hoffnung so leicht aus.
					Mischievous: Erst der Siegestanz, später der Grund!
				}

				Comfort: {
					Curious: Das hilft mehr, als ich erwartet habe.
					Loyal: Ich wusste, dass du bleibst.
					Brave: Ich kann stark sein und das trotzdem brauchen.
					Gentle: Danke, dass du es bemerkt hast.
					Mischievous: Ich war nicht besorgt. Sehr.
				}

				Laugh: {
					Curious: Warte, erklär mir noch einmal, warum das lustig war.
					Loyal: Deinem Lachen folge ich gern.
					Brave: Auch Helden brauchen das.
					Gentle: Ich mag diesen Klang zwischen uns.
					Mischievous: Endlich eine Strategie nach meinem Geschmack!
				}

				Rest: {
					Curious: Na gut, aber ich denke beim Ausruhen weiter.
					Loyal: Ich halte neben dir Wache.
					Brave: Eine taktische Pause. Vernünftig.
					Gentle: Ein stiller Moment zusammen klingt wunderbar.
					Mischievous: Weck mich, falls etwas Lustiges passiert.
				}
			}

			Combat: {
				Creature: {
					Curious: Ich hätte es gern zuerst verstanden.
					Loyal: Ich habe deine Sicherheit gewählt, aber ich erinnere mich daran.
					Brave: Ein Leben endete. Wir sollten es nicht leichtnehmen.
					Gentle: Das wollte ich nicht. Es tut mir leid.
					Mischievous: Das war sehr schnell nicht mehr lustig.
				}

				Victory: {
					Curious: Jetzt verstehe ich, wie sich diese Gefahr bewegt hat.
					Loyal: Du bist sicher. Das genügt.
					Brave: Gefahr beendet. Bleib hinter mir.
					Gentle: Es ist vorbei. Gehen wir weiter.
					Mischievous: Es hätte sich ein anderes Paar aussuchen sollen.
				}

				Boss: {
					Curious: Stell dir vor, was so ein Wesen einmal wusste.
					Loyal: Nichts so Großes stellt sich zwischen uns.
					Brave: An diesen Sieg werden wir uns erinnern!
					Gentle: Die Welt wirkt jetzt stiller.
					Mischievous: Ich glaube, jetzt sind wir die Gefährlichen.
				}
			}
		}

