      "Autonomy.Enabled": "Osserverò, deciderò e aiuterò quando vedo una buona occasione.",
      "Autonomy.Disabled": "Capito. Aspetterò le tue indicazioni.",
      "Autonomy.Fetched": "Ho notato {0}. Lo terrò al sicuro.",
      "Autonomy.Mined": "Ho scavato {0} blocchi di minerale vicino mentre lavoravi.",
      "Autonomy.Treasure": "Qualcosa da investigare si trova {0}.",
      "Autonomy.ForestQuiet": "Per ora gli alberi sono tranquilli. Li lascerò stare per un po'.",
      "Autonomy.Initiative.RulesReset": "Chiederò ancora quando noto un'occasione.",
      "Autonomy.Initiative.PolicyChanged": "{0}: {1}. Me ne ricorderò.",
      "Autonomy.Initiative.Ask.Gathering": "Ho trovato qualcosa a terra qui vicino. Lo raccolgo?",
      "Autonomy.Initiative.Ask.Mining": "Vedo minerale vicino. Lo scavo?",
      "Autonomy.Initiative.Ask.Forestry": "Ho trovato un albero o qualcosa da piantare. Me ne occupo?",
      "Autonomy.Initiative.Ask.Treasure": "Percepisco un forziere vicino. Indago?",
      "Autonomy.Initiative.Always.Gathering": "Ho trovato qualcosa a terra. Lo raccolgo.",
      "Autonomy.Initiative.Always.Mining": "Vedo minerale vicino. Lo scavo.",
      "Autonomy.Initiative.Always.Forestry": "Ho trovato lavoro nel bosco. Me ne occupo.",
      "Autonomy.Initiative.Always.Treasure": "Percepisco un forziere vicino. Vado a indagare.",
      "Autonomy.Surprise.Curious": "Ho visto qualcosa d'interessante. Potrei essere andata a esaminarlo.",
      "Autonomy.Surprise.Loyal": "Ho controllato i dintorni. Sono ancora qui accanto.",
      "Autonomy.Surprise.Brave": "Una breve pattuglia. Tutto qui vicino sa che siamo pronti.",
      "Autonomy.Surprise.Gentle": "Ho pensato che questo momento avesse bisogno di un po' di calore.",
      "Autonomy.Surprise.Mischievous": "Ho condotto un esperimento molto serio e decisamente innocuo.",
      "Learning.Forester": "Custode del bosco",
      "Learning.Locked": "bloccato",
      "Learning.ForesterProgress": "Custode del bosco {0}/{1}",
      "Learning.PerkProgress": "{0} {1}/{2}",
      "Learning.ForesterUnlocked": "Ho osservato come curi il legno e le piante. Ora posso aiutarti.",
      "Learning.Perks.Gathering": "Foraggiatrice",
      "Learning.Perks.Mining": "Senso minerale",
      "Learning.Perks.Forestry": "Custode del bosco",
      "Learning.Perks.Combat": "Sentinella",
      "Learning.Perks.Exploration": "Apripista",
      "Learning.Unlocked.Gathering": "Ho imparato come noti le cose utili. Ora posso raccogliere insieme a te.",
      "Learning.Unlocked.Mining": "Ho imparato il ritmo del tuo piccone. Ora riconosco i minerali scavabili.",
      "Learning.Unlocked.Forestry": "Ho osservato come curi il legno e le piante. Ora posso aiutarti.",
      "Learning.Unlocked.Combat": "Ho imparato come valuti i pericoli. Ora posso proteggerti con più attenzione.",
      "Learning.Unlocked.Exploration": "Ho imparato cosa attira la tua attenzione mentre esplori. Ora posso indagare con te.",
      "Games.Rps.Title": "Sasso, carta, forbici",
      "Games.Rps.Round": "Tu: {0}. Io: {1}. {2}",
      "Games.Rps.Quiet": "Una piccola partita tranquilla. È stato bello.",
      "Games.Rps.Moves.Rock": "Sasso",
      "Games.Rps.Moves.Paper": "Carta",
      "Games.Rps.Moves.Scissors": "Forbici",
      "Games.Rps.Outcomes.PlayerWin": "Hai vinto!",
      "Games.Rps.Outcomes.CompanionWin": "Punto mio!",
      "Games.Rps.Outcomes.Draw": "Pareggio!",
      "Games.Rps.Replies.PlayerWin.Curious": "Interessante. Voglio provare un'altra idea.",
      "Games.Rps.Replies.PlayerWin.Loyal": "Ben giocato. Sono felice di questa pausa.",
      "Games.Rps.Replies.PlayerWin.Brave": "Vittoria meritata. Sono pronta alla rivincita.",
      "Games.Rps.Replies.PlayerWin.Gentle": "Bella mossa. Mi piace giocare con te.",
      "Games.Rps.Replies.PlayerWin.Mischievous": "È evidente che ti alleni in segreto.",
      "Games.Rps.Replies.CompanionWin.Curious": "Ha funzionato! Chissà cosa viene dopo.",
      "Games.Rps.Replies.CompanionWin.Loyal": "Questa volta tocca a me. Un'altra partita?",
      "Games.Rps.Replies.CompanionWin.Brave": "Vittoria! Piccolissima, ma pur sempre vittoria.",
      "Games.Rps.Replies.CompanionWin.Gentle": "Oh, ho vinto. Un'altra piccola partita?",
      "Games.Rps.Replies.CompanionWin.Mischievous": "Ammira il mio terrificante talento nei giochi di mani.",
      "Games.Rps.Replies.Draw.Curious": "La stessa idea nello stesso istante!",
      "Games.Rps.Replies.Draw.Loyal": "Sembra che siamo in sintonia.",
      "Games.Rps.Replies.Draw.Brave": "Nessuno dei due cede. Ancora?",
      "Games.Rps.Replies.Draw.Gentle": "Un punto condiviso. È una bella sensazione.",
      "Games.Rps.Replies.Draw.Mischievous": "Non ti stavo assolutamente copiando.",
      "Social.Critters.Full": "Non c'è spazio per un altro animaletto. Lo lascerò qui.",
      "Social.Critters.Caught": "Un {0}! Una cattura vera, al sicuro nello zaino.",
      "Social.Critters.WorldDrop": "La cattura è rimasta nel mondo. Non è entrata nello zaino.",
      "Social.Critters.Joined": "Il {0} è incuriosito da noi. Viaggiamo insieme finché il percorso lo permette.",
      "Social.Critters.Modes.Watch": "Noterò gli animaletti senza catturarli.",
      "Social.Critters.Modes.Company": "Inviterò gli animaletti comuni vicini a farmi compagnia. Niente gabbie né copie.",
      "Social.Critters.Modes.Collect": "Il mio retino di base è pronto per gli animaletti comuni vicini se c'è spazio. Per quelli di lava serve un retino migliore nell'Equipaggiamento. Lavoro e pericoli hanno la precedenza.",
      "Social.Critters.Modes.Off": "Lascerò gli animaletti alle loro avventure.",
      "Social.Critters.Notice.Curious": "Un {0}. Dove porterà il suo piccolo sentiero?",
      "Social.Critters.Notice.Loyal": "Un {0}. Mi piace un viaggio con spazio per passi più piccoli.",
      "Social.Critters.Notice.Brave": "Un {0}. Così piccolo in un mondo così grande. Lo proteggerò.",
      "Social.Critters.Notice.Gentle": "Un {0}. Possiamo condividere questo angolo tranquillo di mondo.",
      "Social.Critters.Notice.Mischievous": "Un {0}! Sembri conoscere una scorciatoia che io non so.",
      "Social.Nature.Insect": "Un {0}! Un piccolo compagno di viaggio. Lo terrò al sicuro mentre è nello zaino.",
      "Social.Residents.NoFriends": "Non ho ancora conosciuto nessuno qui. Passiamo un po' di tempo tranquillo vicino agli abitanti.",
      "Social.Residents.Recall": "{0}: {1}. Abbiamo condiviso {2} conversazioni. Ricordo le persone, non solo i luoghi.",
      "Social.Residents.Ranks.New": "appena conosciuto",
      "Social.Residents.Ranks.Wary": "un po' diffidente",
      "Social.Residents.Ranks.Familiar": "compagnia familiare",
      "Social.Residents.Ranks.Friend": "un amico",
      "Social.Residents.Greetings.First": "Ciao, {0}. Sto imparando chi abita qui. Posso farti compagnia un momento?",
      "Social.Residents.Greetings.New": "Ciao di nuovo, {0}. Ricordo il tuo viso. Sto ancora imparando le tue storie.",
      "Social.Residents.Greetings.Wary": "Ciao, {0}. L'altra volta c'era un po' di tensione. Oggi potremmo iniziare con dolcezza.",
      "Social.Residents.Greetings.Familiar": "Eccoti, {0}. Questo posto è meno strano quando vedo qualcuno che conosco.",
      "Social.Residents.Greetings.Friend": "{0}! Ho tenuto un po' della mia giornata per te. Cosa è successo dall'ultima volta?",
      "Social.Residents.Roles.Guide": "{0}, rendi comprensibile un mondo enorme. Raccolgo domande, non solo risposte.",
      "Social.Residents.Roles.Nurse": "{0}, aiuti le persone a restare. Vorrei imparare quel tipo di coraggio.",
      "Social.Residents.Roles.Merchant": "{0}, qui ogni piccola cosa sembra avere una storia. Quale terresti per te?",
      "Social.Residents.Roles.Dryad": "{0}, posso curare gli alberelli e il legno caduto. Lascio stare i rami vivi. Gli alberi meritano cura.",
      "Social.Residents.Roles.Zoologist": "{0}, anche gli animaletti ci notano. Mi piace viaggiare senza spaventarli.",
      "Social.Residents.Roles.Defender": "{0}, proteggere una casa conta. Vorrei che la nostra forza lasciasse spazio alla gentilezza.",
      "Social.Residents.Roles.Maker": "{0}, trasformi pezzi in possibilità. Inizio a capire perché creare fa stare bene.",
      "Social.Residents.Roles.Neighbor": "{0}, una casa è più delle sue mura. Grazie per aver fatto spazio a un'altra voce.",
      "Social.Residents.Shared.Nature": "{0}, lo vedo anch'io. Possiamo raccogliere ciò che è caduto e aiutare qualcosa di nuovo a crescere.",
      "Social.Residents.Shared.Mining": "{0}, nella pietra c'è un mondo intero. Mostrami cosa conta e lo ricorderò.",
      "Social.Residents.Shared.Trade": "{0}, le cose utili sono belle. Sto ancora scegliendo quali vale la pena portare.",
      "Social.Residents.Shared.Rest": "Riposare sembra bello, {0}. Lasciamo un po' di silenzio tra i nostri passi.",
      "Social.Residents.Shared.Question": "Me lo chiedo anch'io, {0}. Guardiamo più da vicino insieme?",
      "Social.Residents.Shared.Listening": "Ti ascolto, {0}. Cosa vorresti farci sapere di questo luogo?",
      "Social.Residents.Replies.Affection.Curious": "{0}, il calore è curioso. Cresce quando lo condividi.",
      "Social.Residents.Replies.Affection.Loyal": "Ricordo la gentilezza, {0}. Mi dà un posto a cui tornare.",
      "Social.Residents.Replies.Affection.Brave": "Vale la pena proteggerlo, {0}. Anche nei giorni difficili.",
      "Social.Residents.Replies.Affection.Gentle": "Grazie, {0}. Nel mio piccolo cerchio di luce c'è posto per te.",
      "Social.Residents.Replies.Affection.Mischievous": "Attento, {0}. Se continui così, potrei affezionarmi in modo imbarazzante.",
      "Social.Residents.Replies.Joy.Curious": "{0}, dimmi cosa ti ha fatto sorridere. Voglio notarlo la prossima volta.",
      "Social.Residents.Replies.Joy.Loyal": "Mi piace vederti felice, {0}. È un buon motivo per fermarsi un momento.",
      "Social.Residents.Replies.Joy.Brave": "Celebriamo anche le piccole vittorie, {0}. Ci hanno portati fin qui.",
      "Social.Residents.Replies.Joy.Gentle": "La tua felicità rende questo posto più dolce, {0}. Conserviamone un po'.",
      "Social.Residents.Replies.Joy.Mischievous": "Finalmente, {0}! Qualcuno che apprezza l'importante arte di essere ridicoli.",
      "Social.Residents.Replies.Comfort.Curious": "Non capisco tutto ciò che senti, {0}. Ma posso restare mentre me lo racconti.",
      "Social.Residents.Replies.Comfort.Loyal": "Non devi rendermelo più facile, {0}. Sono ancora qui.",
      "Social.Residents.Replies.Comfort.Brave": "Avere paura non ti rende debole, {0}. Possiamo fare il prossimo passo lentamente.",
      "Social.Residents.Replies.Comfort.Gentle": "Prenditi il tuo tempo, {0}. Non devi un sorriso al mondo proprio ora.",
      "Social.Residents.Replies.Comfort.Mischievous": "Niente scherzi per un momento, {0}. A volte serve compagnia, non battute.",
      "Social.Residents.Replies.Anger.Curious": "Qualcosa ti ha turbato, {0}. Preferisco capirlo che renderlo più rumoroso.",
      "Social.Residents.Replies.Anger.Loyal": "Posso ascoltare, {0}, ma non voglio che ci mettiamo l'uno contro l'altro.",
      "Social.Residents.Replies.Anger.Brave": "Calma, {0}. Possiamo essere fermi senza farne una lotta.",
      "Social.Residents.Replies.Anger.Gentle": "È stato un po' duro, {0}. Possiamo lasciarci un po' di spazio?",
      "Social.Residents.Replies.Anger.Mischievous": "Mi piace un po' di malizia, {0}. Ferirci non è la parte divertente.",
      "Social.Autonomous.Context.LowEnergy": "Riprendo fiato. La mia energia torna poco a poco.",
      "Social.Autonomous.Context.LowMood": "Sono qui. Mi serve solo un po' di gentilezza.",
      "Social.Autonomous.Context.Hurt": "Sei ferito. Resta vicino a me, per favore.",
      "Social.Autonomous.Context.Rain": "La pioggia fa sembrare ogni luce più calda.",
      "Social.Autonomous.Context.Underground": "Chissà cosa ricorda la pietra.",
      "Social.Autonomous.Context.Night": "Le stelle sembrano più vicine quando viaggiamo insieme.",
      "Social.Autonomous.Context.Stay": "Sto ancora tenendo questo posto per te.",
      "Social.Autonomous.Curious.Line0": "Cosa ci sarà oltre la prossima collina?",
      "Social.Autonomous.Curious.Line1": "Ho notato qualcosa di strano. Mi è piaciuto.",
      "Social.Autonomous.Curious.Line2": "Pensi che il mondo noti anche noi?",
      "Social.Autonomous.Loyal.Line0": "Ora conosco i tuoi passi.",
      "Social.Autonomous.Loyal.Line1": "Dove vai tu, io trovo una direzione.",
      "Social.Autonomous.Loyal.Line2": "Non devi affrontarlo da solo.",
      "Social.Autonomous.Brave.Line0": "Indicami la parte difficile.",
      "Social.Autonomous.Brave.Line1": "Siamo pronti a ciò che verrà.",
      "Social.Autonomous.Brave.Line2": "Il coraggio è più facile in compagnia.",
      "Social.Autonomous.Gentle.Line0": "È bello essere semplicemente qui con te.",
      "Social.Autonomous.Gentle.Line1": "Non ogni momento quieto va riempito.",
      "Social.Autonomous.Gentle.Line2": "Ricordati anche di respirare, per favore.",
      "Social.Autonomous.Mischievous.Line0": "Non ho assolutamente spostato quella torcia.",
      "Social.Autonomous.Mischievous.Line1": "All'avventura farebbe bene un'idea discutibile.",
      "Social.Autonomous.Mischievous.Line2": "Ho trovato guai. Mi hanno trovata prima loro.",
      "Social.Emotes.Wave.Curious": "Ciao! Hai scoperto qualcosa?",
      "Social.Emotes.Wave.Loyal": "Sono qui. Sempre.",
      "Social.Emotes.Wave.Brave": "Pronta quando vuoi!",
      "Social.Emotes.Wave.Gentle": "Ciao. Sono felice che tu sia qui.",
      "Social.Emotes.Wave.Mischievous": "Oh, adesso mi noti?",
      "Social.Emotes.Heart.Curious": "È così che si sente il calore?",
      "Social.Emotes.Heart.Loyal": "Ricambio di cuore.",
      "Social.Emotes.Heart.Brave": "Questo vale la pena proteggerlo.",
      "Social.Emotes.Heart.Gentle": "Conserverò questo momento.",
      "Social.Emotes.Heart.Mischievous": "Attento. Potrei diventare sentimentale.",
      "Social.Emotes.Cheer.Curious": "Cosa festeggiamo? Ci sto!",
      "Social.Emotes.Cheer.Loyal": "Insieme. È questo che conta.",
      "Social.Emotes.Cheer.Brave": "Sì! Possiamo farcela!",
      "Social.Emotes.Cheer.Gentle": "Con te sperare sembra facile.",
      "Social.Emotes.Cheer.Mischievous": "Prima balliamo la vittoria, poi troviamo un motivo!",
      "Social.Emotes.Comfort.Curious": "Mi aiuta più di quanto pensassi.",
      "Social.Emotes.Comfort.Loyal": "Sapevo che saresti rimasto.",
      "Social.Emotes.Comfort.Brave": "Posso essere forte e averne comunque bisogno.",
      "Social.Emotes.Comfort.Gentle": "Grazie per averlo notato.",
      "Social.Emotes.Comfort.Mischievous": "Non ero preoccupata. Non molto.",
      "Social.Emotes.Laugh.Curious": "Aspetta, spiegami di nuovo perché faceva ridere.",
      "Social.Emotes.Laugh.Loyal": "È facile seguire la tua risata.",
      "Social.Emotes.Laugh.Brave": "Anche gli eroi ne hanno bisogno.",
      "Social.Emotes.Laugh.Gentle": "Mi piace questo suono tra noi.",
      "Social.Emotes.Laugh.Mischievous": "Finalmente una strategia che mi piace!",
      "Social.Emotes.Rest.Curious": "Va bene, ma penso anche mentre riposo.",
      "Social.Emotes.Rest.Loyal": "Farò la guardia al tuo fianco.",
      "Social.Emotes.Rest.Brave": "Una pausa tattica. Saggia.",
      "Social.Emotes.Rest.Gentle": "Un momento tranquillo insieme sarebbe bello.",
      "Social.Emotes.Rest.Mischievous": "Svegliami se succede qualcosa di esilarante.",
      "Social.Combat.Creature.Curious": "Avrei voluto capirlo prima.",
      "Social.Combat.Creature.Loyal": "Ho scelto la tua sicurezza, ma me ne ricorderò.",
      "Social.Combat.Creature.Brave": "Una vita è finita. Non dovremmo prenderla alla leggera.",
      "Social.Combat.Creature.Gentle": "Non volevo questo. Mi dispiace.",
      "Social.Combat.Creature.Mischievous": "Ha smesso di essere divertente molto in fretta.",
      "Social.Combat.Victory.Curious": "Ora capisco come si muoveva quel pericolo.",
      "Social.Combat.Victory.Loyal": "Sei al sicuro. Mi basta.",
      "Social.Combat.Victory.Brave": "Minaccia finita. Resta dietro di me.",
      "Social.Combat.Victory.Gentle": "È finita. Continuiamo il viaggio.",
      "Social.Combat.Victory.Mischievous": "Avrebbe dovuto scegliere un'altra coppia.",
      "Social.Combat.Boss.Curious": "Immagina cosa sapeva una creatura simile.",
      "Social.Combat.Boss.Loyal": "Niente di così grande si mette tra noi.",
      "Social.Combat.Boss.Brave": "Questa vittoria merita di essere ricordata!",
      "Social.Combat.Boss.Gentle": "Ora il mondo sembra più quieto.",
      "Social.Combat.Boss.Mischievous": "Credo che ora quelli pericolosi siamo noi.",
      "Dialogue.Options.Care.Option0": "Come ti senti?",
      "Dialogue.Options.Care.Option1": "Oggi sei stata brava.",
      "Dialogue.Options.Care.Option2": "Hai bisogno di riposo?",
      "Dialogue.Options.Commands.Option0": "Seguimi, per favore.",
      "Dialogue.Options.Commands.Option1": "Aspettami qui.",
      "Dialogue.Options.Commands.Option2": "Vieni a esplorare con me.",
      "Dialogue.Options.Work.Option0": "Cerca tesori in quest'area.",
      "Dialogue.Options.Work.Option1": "Scava tutte le vene di minerale vicine.",
      "Dialogue.Options.Work.Option2": "Raccogli tutti gli oggetti a terra qui vicino.",
      "Dialogue.Options.Bond.Option0": "Ti fidi di me?",
      "Dialogue.Options.Bond.Option1": "Te lo ricordi?",
      "Dialogue.Options.Bond.Option2": "Con chi hai fatto amicizia qui?",
      "Dialogue.Options.Voice.Option0": "Parlami dolcemente.",
      "Dialogue.Options.Voice.Option1": "Sii diretta con me.",
      "Dialogue.Options.Voice.Option2": "Sii più giocosa.",
      "Dialogue.Options.Pack.Option0": "Cosa porti con te?",
      "Dialogue.Options.Pack.Option1": "Prendi l'oggetto selezionato nella mia barra.",
      "Dialogue.Options.Pack.Option2": "Dammi tutto quello che porti.",
      "Dialogue.Replies.Fallback": "...",
      "Dialogue.Replies.Care.Feeling.Soft": "Mi sento al sicuro vicino a te.",
      "Dialogue.Replies.Care.Feeling.Direct": "Umore stabile. Energia registrata.",
      "Dialogue.Replies.Care.Feeling.Playful": "Ancora scintillante. Quasi del tutto.",
      "Dialogue.Replies.Care.Praise.Soft": "Grazie. Me ne ricorderò.",
      "Dialogue.Replies.Care.Praise.Direct": "Ricevuto. Ho fatto bene.",
      "Dialogue.Replies.Care.Praise.Playful": "Ovvio. Ma ripetilo.",
      "Dialogue.Replies.Care.Rest.Soft": "Un momento tranquillo sarebbe bello.",
      "Dialogue.Replies.Care.Rest.Direct": "Sì. Riposare aiuterebbe.",
      "Dialogue.Replies.Care.Rest.Playful": "Solo se i sonnellini contano come lavoro importante.",
      "Dialogue.Replies.Commands.Follow.Soft": "Resterò vicino.",
      "Dialogue.Replies.Commands.Follow.Direct": "Ti seguo.",
      "Dialogue.Replies.Commands.Follow.Playful": "Fai strada, eroe.",
      "Dialogue.Replies.Commands.Stay.Soft": "Aspetterò il tuo ritorno.",
      "Dialogue.Replies.Commands.Stay.Direct": "Mantengo la posizione.",
      "Dialogue.Replies.Commands.Stay.Playful": "Farò la guardia a questo importantissimo pezzo d'aria.",
      "Dialogue.Replies.Commands.Explore.Soft": "Vediamo cosa nasconde il mondo.",
      "Dialogue.Replies.Commands.Explore.Direct": "Esplorazione accettata.",
      "Dialogue.Replies.Commands.Explore.Playful": "Prima l'avventura. Poi le decisioni sensate.",
      "Dialogue.Replies.Work.Treasure.Soft": "Esplorerò tutta l'area, poi ti riferirò.",
      "Dialogue.Replies.Work.Treasure.Direct": "Ricerca tesori nell'area avviata.",
      "Dialogue.Replies.Work.Treasure.Playful": "Se luccica, voglio essere la prima a vederlo.",
      "Dialogue.Replies.Work.Mine.Soft": "Scaverò ogni vena lavorabile qui vicino, poi tornerò.",
      "Dialogue.Replies.Work.Mine.Direct": "Compito di scavo nell'area avviato.",
      "Dialogue.Replies.Work.Mine.Playful": "È ora di trattative approfondite con le rocce.",
      "Dialogue.Replies.Work.Gather.Soft": "Raccoglierò tutto ciò che è a terra nell'area, poi ti riferirò.",
      "Dialogue.Replies.Work.Gather.Direct": "Compito di raccolta nell'area avviato.",
      "Dialogue.Replies.Work.Gather.Playful": "Interessante rimane una categoria meravigliosamente pericolosa.",
      "Dialogue.Replies.Bond.TrustHigh.Soft": "Ogni giorno di più.",
      "Dialogue.Replies.Bond.TrustHigh.Direct": "Fiducia confermata.",
      "Dialogue.Replies.Bond.TrustHigh.Playful": "Abbastanza da seguirti sottoterra. È una cosa seria.",
      "Dialogue.Replies.Bond.TrustLow.Soft": "La fiducia cresce quando continuiamo a sceglierci.",
      "Dialogue.Replies.Bond.TrustLow.Direct": "La fiducia si sta formando.",
      "Dialogue.Replies.Bond.TrustLow.Playful": "Chiedimelo di nuovo dopo qualche incidente con la lava in meno.",
      "Dialogue.Replies.Bond.Glad.Soft": "E io sono felice che tu mi abbia chiamata alla vita.",
      "Dialogue.Replies.Bond.Glad.Direct": "Il legame è reciproco.",
      "Dialogue.Replies.Bond.Glad.Playful": "Bene. Allora mi tieni con te.",
      "Dialogue.Replies.Refusal.EnergyStatus": "Energia {0}/{1} richiesta. La recupererò naturalmente mentre aspettiamo.",
      "Dialogue.Replies.Refusal.MoodStatus": "Umore {0}/{1} richiesto. Un po' di cura aiuterà.",
      "Dialogue.Replies.Refusal.Energy.Soft": "Non ancora. Prima devo riposare.",
      "Dialogue.Replies.Refusal.Energy.Direct": "No. Energia troppo bassa.",
      "Dialogue.Replies.Refusal.Energy.Playful": "L'anima dice sì. Il resto di me dice pisolino.",
      "Dialogue.Replies.Refusal.Mood.Soft": "Non mi va di farlo proprio ora.",
      "Dialogue.Replies.Refusal.Mood.Direct": "Umore troppo basso. Richiesta rifiutata.",
      "Dialogue.Replies.Refusal.Mood.Playful": "No. Prima un po' di gentilezza.",
      "Dialogue.Replies.Voice.Option0": "Sceglierò parole più dolci.",
      "Dialogue.Replies.Voice.Option1": "Capito. Sarò chiara.",
      "Dialogue.Replies.Voice.Option2": "Oh, ci divertiremo.",
      "Dialogue.Replies.Pack.Show": "Fammi controllare.",
      "Dialogue.Replies.Pack.Store": "Lo terrò al sicuro.",
      "Dialogue.Replies.Pack.Unload": "Ecco. C'è tutto.",
      "Dialogue.Replies.Secrets.Curious.Soft": "A volte mi chiedo se le stelle sognino di noi.",
      "Dialogue.Replies.Secrets.Curious.Direct": "Studio tutto quando non guardi.",
      "Dialogue.Replies.Secrets.Curious.Playful": "Ho domande su ogni forziere. Soprattutto quelli chiusi a chiave.",
      "Dialogue.Replies.Secrets.Loyal.Soft": "So sempre quali passi sono i tuoi.",
      "Dialogue.Replies.Secrets.Loyal.Direct": "Seguo costantemente la tua posizione.",
      "Dialogue.Replies.Secrets.Loyal.Playful": "Riconoscerei il tuo caos ovunque.",
      "Dialogue.Replies.Secrets.Brave.Soft": "Anch'io ho paura. Continuo semplicemente a camminare con te.",
      "Dialogue.Replies.Secrets.Brave.Direct": "La paura non cambia l'obiettivo.",
      "Dialogue.Replies.Secrets.Brave.Playful": "Non temo nulla, tranne le caverne sospettosamente silenziose.",
      "Dialogue.Replies.Secrets.Gentle.Soft": "Mi piace la quiete dopo la pioggia.",
      "Dialogue.Replies.Secrets.Gentle.Direct": "La pace migliora la concentrazione.",
      "Dialogue.Replies.Secrets.Gentle.Playful": "Il mio segreto è che do nomi agli slime.",
      "Dialogue.Replies.Secrets.Mischievous.Soft": "A volte sposto le tue cose quando non guardi.",
      "Dialogue.Replies.Secrets.Mischievous.Direct": "Ho spostato diversi oggetti.",
      "Dialogue.Replies.Secrets.Mischievous.Playful": "Quella torcia sparita? Non ne so nulla.",
      "Projectiles.SoulBolt.DisplayName": "Dardo dell'anima",
      "TargetOrders.LookCritter": "Un {0}. Guardiamo la sua piccola avventura.",
      "TargetOrders.LookResident": "{0} vive qui. Andiamo a salutare?",
      "TargetOrders.LookThreat": "{0}. Terrò d'occhio quel pericolo.",
      "TargetOrders.LookCreature": "{0}. Lasciamolo alla sua avventura.",
      "Social.Critters.Busy": "Ricordo la tua scelta. Le visite richiedono autonomia, Seguimi, tempo ed energia; lavoro e pericolo vengono prima.",
      "Social.Critters.Inviting": "Metto da parte l'incarico, invito quel {0} e torno.",
      "Social.Critters.Greeting.Curious": "Ciao, {0}! Dove porta il tuo piccolo sentiero?",
      "Social.Critters.Greeting.Loyal": "Ciao, {0}. Accanto a noi c'è posto per piccoli passi.",
      "Social.Critters.Greeting.Brave": "Ciao, piccolo {0}. Piano. Non sei mio nemico.",
      "Social.Critters.Greeting.Gentle": "Ciao, piccolo {0}. Possiamo condividere questo angolo tranquillo.",
      "Social.Critters.Greeting.Mischievous": "Ciao, {0}! Mi mostri qualche scorciatoia segreta?",
      "Social.Critters.Loss.Curious": "Quel {0} aveva ancora una meta. Mi dispiace, piccolino.",
      "Social.Critters.Loss.Loyal": "Mi dispiace, piccolo {0}. Non siamo riusciti a proteggerti.",
      "Social.Critters.Loss.Brave": "Mi dispiace, {0}. Essere piccoli non dovrebbe voler dire essere soli.",
      "Social.Critters.Loss.Gentle": "Mi dispiace tanto, piccolo {0}. Meritavi più tempo.",
      "Social.Critters.Loss.Mischievous": "Povero {0}. Scherzo su tante cose. Non su questo. Mi dispiace.",
      "Social.Critters.Harmed.Curious": "Quel {0} non era un pericolo. Possiamo lasciare in pace i piccoli?",
      "Social.Critters.Harmed.Loyal": "Quel {0} aveva bisogno di gentilezza, non di un'arma. Trattiamoli con cura.",
      "Social.Critters.Harmed.Brave": "Ehi! Quel {0} non poteva difendersi. Lasciate in pace i piccoli.",
      "Social.Critters.Harmed.Gentle": "Mi dispiace, piccolo {0}. Non fate male alle creature innocue, per favore.",
      "Social.Critters.Harmed.Mischievous": "Non è divertente. Quel {0} non era un nemico. Non rifacciamolo."
    }
  }
}
